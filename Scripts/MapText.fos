// MapText — текст на карте: реплики над головами криттеров и всплывающий/статичный текст в гексах.
// SERVER: рассылает текст клиентам, которые видят криттера или гекс, через ReceiveMapText.
// CLIENT: хранит активные подписи, анимирует их (всплытие, прозрачность) и отрисовывает в интерфейсе.
// Показ имён НПЦ берёт из InputHandler (F11); ClientHealthDisplay добавляет ОЖ игроков и мерков независимо от F11.
// Глобальный MapTexts хранит очередь временных подписей карты между кадрами; очищается при смене карты.
// Имя главного спутника Сьерры рисует зелёным; цвет реплик и остальных имён не меняет.
// COMMON: набор перегрузок AddText/AddFlyingText даёт единый вызов для серверной и клиентской сторон.
namespace MapText
{

///@ Setting Client int32 Gui.TextDelay
///@ Setting Client string Gui.PlayerOffAppendix

///@ Property Critter Client string TextOnHead Mutable
///@ Property Critter Client nanotime TextOnHeadEndTime Mutable

///@ RemoteCall Client ReceiveMapText(bool flying, ident crId, mpos hex, ucolor color, string text, TextPackKey textKey, string textArgs)

[[ModuleInit]]
void InitMapText()
{
#if CLIENT
    Game.OnPreRenderIface.Subscribe(OnPreRenderIface);
    Game.OnMapLoad.Subscribe(OnMapLoad);
    Game.OnMapUnload.Subscribe(OnMapUnload);
#endif
}

#if SERVER

// Удобные перегрузки: текст либо привязан к криттеру, либо к гексу карты; пустой текст не рассылаем.
void AddText(Critter cr, ucolor color, string text)
{
    if (!text.isEmpty()) {
        AddText(false, cr, color, text, TextPackKey(), "");
    }
}

void AddText(Critter cr, ucolor color, TextPackKey textKey, string textArgs = "")
{
    AddText(false, cr, color, "", textKey, textArgs);
}

void AddText(Map map, mpos hex, ucolor color, string text)
{
    if (!text.isEmpty()) {
        AddText(false, map, hex, color, text, TextPackKey(), "");
    }
}

void AddText(Map map, mpos hex, ucolor color, TextPackKey textKey, string textArgs = "")
{
    AddText(false, map, hex, color, "", textKey, textArgs);
}

void AddFlyingText(Critter cr, ucolor color, string text)
{
    if (!text.isEmpty()) {
        AddText(true, cr, color, text, TextPackKey(), "");
    }
}

void AddFlyingText(Critter cr, ucolor color, TextPackKey textKey, string textArgs = "")
{
    AddText(true, cr, color, "", textKey, textArgs);
}

void AddFlyingText(Map map, mpos hex, ucolor color, string text)
{
    if (!text.isEmpty()) {
        AddText(true, map, hex, color, text, TextPackKey(), "");
    }
}

void AddFlyingText(Map map, mpos hex, ucolor color, TextPackKey textKey, string textArgs = "")
{
    AddText(true, map, hex, color, "", textKey, textArgs);
}

// Базовая рассылка: шлём текст всем игрокам, которые видят данного криттера (вне карты криттера пропускаем).
void AddText(bool flying, Critter cr, ucolor color, string text, TextPackKey textKey, string textArgs)
{
    if (cr.MapId == ZERO_IDENT) {
        return;
    }

    Critter[] critters = cr.GetCritters(CritterSeeType::WhoSeeMe, CritterFindType::Players);

    for (int i = 0; i < critters.length(); i++) {
        critters[i].PlayerClientCall.ReceiveMapText(flying, cr.Id, cr.Hex, color, text, textKey, textArgs);
    }
}

void AddText(bool flying, Map map, mpos hex, ucolor color, string text, TextPackKey textKey, string textArgs)
{
    Critter[] critters = map.GetCrittersWhoSeeHex(hex, CritterFindType::Players);

    for (int i = 0; i < critters.length(); i++) {
        critters[i].PlayerClientCall.ReceiveMapText(flying, ZERO_IDENT, hex, color, text, textKey, textArgs);
    }
}

#endif

#if CLIENT

class MapText
{
    bool Flying;
    mpos Hex;
    ucolor Color;
    nanotime StartTime;
    timespan Duration;
    ipos StartPos;
    ipos EndPos;
    isize Size;
    string Text;
};

MapText[] MapTexts = {};

void AddText(Critter cr, ucolor color, string text)
{
    if (!text.isEmpty()) {
        AddText(false, cr, cr.Hex, color, text, TextPackKey(), "");
    }
}

void AddText(Critter cr, ucolor color, TextPackKey textKey, string textArgs = "")
{
    AddText(false, cr, cr.Hex, color, "", textKey, textArgs);
}

void AddText(mpos hex, ucolor color, string text)
{
    if (!text.isEmpty()) {
        AddText(false, null, hex, color, text, TextPackKey(), "");
    }
}

void AddText(mpos hex, ucolor color, TextPackKey textKey, string textArgs = "")
{
    AddText(false, null, hex, color, "", textKey, textArgs);
}

void AddFlyingText(Critter cr, ucolor color, string text)
{
    if (!text.isEmpty()) {
        AddText(true, cr, cr.Hex, color, text, TextPackKey(), "");
    }
}

void AddFlyingText(Critter cr, ucolor color, TextPackKey textKey, string textArgs = "")
{
    AddText(true, cr, cr.Hex, color, "", textKey, textArgs);
}

void AddFlyingText(mpos hex, ucolor color, string text)
{
    if (!text.isEmpty()) {
        AddText(true, null, hex, color, text, TextPackKey(), "");
    }
}

void AddFlyingText(mpos hex, ucolor color, TextPackKey textKey, string textArgs = "")
{
    AddText(true, null, hex, color, "", textKey, textArgs);
}

[[ClientRemoteCall]]
void ReceiveMapText(bool flying, ident crId, mpos hex, ucolor color, string text, TextPackKey textKey, string textArgs)
{
    Critter? cr = Game.GetCritter(crId);
    AddText(flying, cr, hex, color, text, textKey, textArgs);
}

void AddText(bool flying, Critter? cr, mpos hex, ucolor color, string text, TextPackKey textKey, string textArgs)
{
    if (text.isEmpty()) {
        if (!Game.IsTextPresent(textKey)) {
            return;
        }

        text = Game.GetText(textKey);
    }

    if (!flying && cr != null) {
        cr.TextOnHead = text;
        cr.TextOnHeadEndTime = Game.FrameTime + Time::Milliseconds(Settings.Gui.TextDelay + text.length() * 100);
        return;
    }

    isize hexContentSize = CurMap.GetHexContentSize(hex);

    MapText mapText = MapText();
    mapText.Flying = flying;
    mapText.Hex = hex;
    mapText.Color = color;
    mapText.StartTime = Game.FrameTime;
    mapText.Duration = Time::Milliseconds(Settings.Gui.TextDelay + text.length() * 100);
    mapText.StartPos = ipos(0, -hexContentSize.height);
    mapText.EndPos = mapText.StartPos;
    mapText.Size = isize(Math::Max(hexContentSize.width, 200), 0);
    mapText.Text = text;

    if (flying) {
        mapText.EndPos.x += Game.Random(-5, 5);
        mapText.EndPos.y -= 20;
    }
    else {
        for (int i = 0; i < MapTexts.length();) {
            if (!MapTexts[i].Flying && MapTexts[i].Hex == hex) {
                MapTexts.removeAt(i);
            }
            else {
                i++;
            }
        }
    }

    MapTexts.insertLast(mapText);
}

[[Event]]
void OnPreRenderIface()
{
    if (!HasCurMap) {
        return;
    }

    DrawCritterTexts();
    DrawMapTexts();
}

[[Event]]
void OnMapLoad()
{
    MapTexts.clear();
}

[[Event]]
void OnMapUnload()
{
    MapTexts.clear();
}

void DrawCritterTexts()
{
    Critter[] critters = CurMap.GetCritters(CritterFindType::NonDead);
    critters = Game.SortCrittersByDeep(critters);

    for (int i = 0; i < critters.length(); i++) {
        Critter cr = critters[i];
        DrawCritterText(cr);
    }
}

void DrawCritterText(Critter cr)
{
    ipos headBox;

    if (cr.HideSprite || !cr.GetTextPos(headBox)) {
        return;
    }

    int crAlpha = cr.GetAlpha();
    if (crAlpha == 0) {
        return;
    }

    bool drawSpeech = Game.FrameTime < cr.TextOnHeadEndTime;
    bool drawHealth = ClientHealthDisplay::ShouldShow(cr);
    if (!drawSpeech && !drawHealth && !cr.ControlledByPlayer && !InputHandler::IsNpcNamesShown()) {
        return;
    }

    ucolor textColor = Color::Text;
    textColor.alpha = crAlpha;

    // Реплика остаётся на прежнем месте; имя и ОЖ располагаются выше её измеренного блока.
    if (drawSpeech) {
        isize speechBox = DrawCritterLabel(cr.TextOnHead, headBox, textColor);
        headBox.y -= speechBox.height + 2;
    }

    if (!drawSpeech || drawHealth) {
        string name = cr.IsOffline() ? cr.Name + Settings.Gui.PlayerOffAppendix : cr.Name;
        ucolor nameColor = GetCritterNameColor(cr);
        nameColor.alpha = crAlpha;
        isize nameBox = DrawCritterLabel(name, headBox, nameColor);
        headBox.y -= nameBox.height + 2;
    }

    if (drawHealth) {
        DrawCritterLabel(ClientHealthDisplay::GetText(cr), headBox, textColor);
    }
}

ucolor GetCritterNameColor(Critter cr)
{
    if (cr.ControlledByPlayer) {
        int highlight = cr.PlayerKarma / 10;
        return ucolor(Color::PlayerName.red + highlight, Color::PlayerName.green + highlight, Color::PlayerName.blue + highlight);
    }

    return cr.ProtoId == "DenDefenseLeader".hstr() ? Color::Green : Color::CritterName;
}

isize DrawCritterLabel(string text, ipos bottom, ucolor color)
{
    TextFormat format = TextFormat(FontType::Default, FontFlag(int(FontFlag::CenterX) | int(FontFlag::AlignBottom) | int(FontFlag::Bordered)), 0);
    isize textBox;
    int textLines = 0;
    Game.GetTextInfo(text, isize(200, 500), format, textBox, textLines);
    Game.DrawText(text, bottom - ipos(textBox.width / 2, textBox.height), textBox, color, format);
    return textBox;
}

void DrawMapTexts()
{
    for (int i = 0; i < MapTexts.length();) {
        MapText mapText = MapTexts[i];
        int elapsedMs = (Game.FrameTime - mapText.StartTime).milliseconds;
        int durationMs = mapText.Duration.milliseconds;
        float t = float(elapsedMs) / float(durationMs);

        if (t >= 1.0) {
            MapTexts.removeAt(i);
            continue;
        }

        ipos hexPos = CurMap.GetHexScreenPos(mapText.Hex);
        ucolor color = mapText.Color;

        if (elapsedMs < 500) {
            color.alpha = Math::RoundToInt(255 * (elapsedMs / 500.0));
        }
        else if (durationMs - elapsedMs < 500) {
            color.alpha = Math::RoundToInt(255 * ((durationMs - elapsedMs) / 500.0));
        }
        else {
            color.alpha = 255;
        }

        ipos hexOffset = Math::Lerp(mapText.StartPos, mapText.EndPos, t) + ipos(-mapText.Size.width / 2, 0);
        Game.DrawText(mapText.Text,
                      hexPos + hexOffset,
                      mapText.Size,
                      color,
                      TextFormat(FontType::Default, FontFlag(int(FontFlag::CenterX) | int(FontFlag::AlignBottom) | int(FontFlag::Bordered)), 0));

        i++;
    }
}

#endif

}
