// TownSupply — отключённая механика карательных охотников за нападение на мирного NPC в городе.
// SERVER: новые и отложенные вызовы ничего не создают; прежняя охрана удаляется без продолжения охоты.
// Свойства и обработчики сохранены для загрузки прежних миров и отложенных TimeEvent'ов.
// Связи: Main (вызов после убийства NPC), NpcPlanes (остановка прежней охраны).
namespace TownSupply
{

#if SERVER

///@ Property Critter Server ident TownSupplyVictimId Mutable Persistent
///@ Property Critter Server ident TownSupplyHostileId Mutable Persistent

// Оставляем точку входа Main, но больше не назначаем карательные отряды.
void CallTownSupply(Critter victim, Critter hostile)
{
}

// Ранее сохранённый вызов завершается без спавна и повторного назначения.
[[TimeEvent]]
void CallTownSupplyNext(any[] values)
{
}

void CallSupply(ident victimId, Critter target, int supplyCount)
{
}

void GuardInit(Critter bountyHunter, bool firstTime)
{
    NpcPlanes::DropPlanes(bountyHunter);
    bountyHunter.StartTimeEvent(Time::Asap(), GuardIdle);
}

// Удаление отложено до завершения инициализации загруженного криттера.
[[TimeEvent]]
void GuardIdle(Critter bountyHunter)
{
    Game.DestroyCritter(bountyHunter);
}

[[Event]]
void GuardDead(Critter bountyHunter, Critter? killer)
{
    Game.DestroyCritter(bountyHunter);
}

[[Event]]
void GuardSmthDead(Critter bountyHunter, Critter fromCrit, Critter? killer)
{
}

void GuardSmthAttack(Critter bountyHunter, Critter fromCrit, Critter target)
{
}

[[Event]]
EventResult GuardPlaneEnd(Critter bountyHunter, int planeId, int reason, Critter someCr, Item someItem)
{
    Game.DestroyCritter(bountyHunter);
    return EventResult::StopChain;
}

#endif

}
