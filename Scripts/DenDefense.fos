// DenDefense — «Осада Сьерры»: общий старт у Смитти и единственный владелец состояния осады.
// SERVER: подтверждённый вход, поколения попыток, участники, спутники, отдых, волны и вещи.
// CLIENT: затемнение отдыха и блокировка действий при провале без ролика и скрытия тела.
// Состояние хранится в свойствах Game/Critter/Map; загрузка сама по себе не начинает попытку.
// Самолечением нанятых спутников управляет Merc; контроллер лечит стимпаками только Смитти.
// Случайное имя спутника выбирается при создании и хранится локализуемым тегом в TextArgs.
// Связи: PlayerRegistration, Main, Merc, DenCleanup, DenWander, NpcPlanes; диалоги den_defense_*.
namespace DenDefense
{

///@ Property Game Client bool DenDefenseClientFrozen Mutable
// Прежний флаг ролика сохраняем в метаданных для совместимости, но больше не используем.
///@ Property Game Client bool DenDefenseClientShowFailure Mutable
///@ Property Game Client int32 DenDefenseClientGeneration Mutable
///@ Property Game Client bool DenDefenseClientResting Mutable
///@ Property Game Client int32 DenDefenseClientRestPhase Mutable
///@ Property Game Client nanotime DenDefenseClientBlackAt Mutable

///@ RemoteCall Client DenDefenseTransition(int32 generation, int32 state)
///@ RemoteCall Client DenDefenseRestTransition(int32 generation, int32 phase, timespan remaining)

#if SERVER

///@ Property Game Server int32 DenDefenseGeneration Mutable Persistent
///@ Property Game Server ident DenDefenseMapId Mutable Persistent
///@ Property Game Server ident DenDefensePrimaryId Mutable Persistent
///@ Property Game Server ident DenDefenseSmittyId Mutable Persistent
///@ Property Game Server ident[] DenDefenseCompanionIds Mutable Persistent
///@ Property Game Server ident[] DenDefenseParticipantIds Mutable Persistent
///@ Property Game Server int32 DenDefenseStage Mutable Persistent
///@ Property Game Server int32 DenDefenseWave Mutable Persistent
///@ Property Game Server int32 DenDefenseSpawned Mutable Persistent
///@ Property Game Server int32 DenDefenseSpawnTotal Mutable Persistent
///@ Property Game Server int32[] DenDefenseSpawnGroups Mutable Persistent
///@ Property Game Server ident[] DenDefenseEnemyIds Mutable Persistent
///@ Property Game Server ident[] DenDefenseEnemyHistory Mutable Persistent
///@ Property Map Server nanotime DenDefenseNextSpawn Mutable
///@ Property Game Server int32 DenDefenseSpawnRetries Mutable Persistent
///@ Property Game Server int32 DenDefenseRestPhase Mutable Persistent
///@ Property Game Server nanotime DenDefenseRestUntil Mutable
///@ Property Game Server synctime DenDefenseDawn Mutable Persistent
///@ Property Game Server bool DenDefenseDawnLocked Mutable Persistent
///@ Property Game Server bool DenDefenseRestUsed Mutable Persistent
// Зарезервированный флаг прежнего показа ролика: сохраняем сериализованный контракт.
///@ Property Game Server bool DenDefenseFailurePresented Mutable Persistent

///@ Property Critter Server int32 DenDefenseGeneration Mutable Persistent
///@ Property Critter Server int32 DenDefenseKitGeneration Mutable Persistent
///@ Property Critter Server int32 DenDefenseRole Mutable Persistent
///@ Property Critter Server int32 DenDefenseRewardGeneration Mutable Persistent
///@ Property Critter Server int32 DenDefenseBrother Mutable Persistent
///@ Property Item Server bool DenDefenseFiniteAmmo Mutable Persistent

const int STAGE_WAITING = 1;
const int STAGE_RESTING = 2;
const int STAGE_FIGHTING = 3;
const int STAGE_VICTORY = 4;
const int STAGE_FAILED = 5;
const int STAGE_STARTING = 6;
const int ROLE_SMITTY = 1;
const int ROLE_COMPANION = 2;
const int ROLE_ENEMY = 3;

[[ModuleInit]]
void InitDenDefense()
{
    Game.OnCritterDead.Subscribe(HandleCritterDeath, EventPriority::High);
    Game.OnCritterAttacked.Subscribe(HandleCritterAttack, EventPriority::High);
    Game.OnStart.Subscribe(ResumeController);
}

Map? GetBaseMap()
{
    return Game.GetMap(Content::Map::sad_enter);
}

// Свободный гекс должен иметь выход к мастерской, а не быть карманом между машинами.
// Проверяем все кольца от центра: случайная проверка одного гекса связность не гарантирует.
bool FindBaseSpawnHex(Map map, mpos center, int radius, mpos& hex)
{
    const mpos workshop = mpos(37, 60);
    for (int ring = 0; ring <= radius; ring++) {
        for (int x = int(center.x) - ring; x <= int(center.x) + ring; x++) {
            for (int y = int(center.y) - ring; y <= int(center.y) + ring; y++) {
                if (x < 0 || y < 0 || x >= int(map.Size.width) || y >= int(map.Size.height)) {
                    continue;
                }
                mpos candidate = mpos(x, y);
                if (Game.GetDistance(center, candidate) == ring && map.IsHexMovable(candidate) && map.GetCritterOnHex(candidate) == null &&
                    (Game.GetDistance(candidate, workshop) <= 1 || map.GetPathLength(candidate, workshop, 1, CanLeaveSpawnHouse) > 0)) {
                    hex = candidate;
                    return true;
                }
            }
        }
    }
    return false;
}

// До коммита логина допустим только перенос: никаких притязаний на поколение, набор или отряд.
bool PlacePlayer(Critter cr)
{
    Map? map = GetBaseMap();
    if (map == null) {
        return false;
    }

    mpos hex = mpos(43, 55);
    if (!FindBaseSpawnHex(map, hex, 6, hex)) {
        return false;
    }

    cr.TransferToMap(map, hex, HDIR_Random);
    if (cr.MapId != map.Id) {
        return false;
    }

    Location::SetKnownLoc(cr, map.GetLocation());
    return true;
}

bool IsParticipant(Critter cr)
{
    return cr.ControlledByPlayer && cr.DenDefenseGeneration == Game.DenDefenseGeneration && Game.DenDefenseGeneration > 0;
}

bool IsActor(Critter cr)
{
    return cr.DenDefenseRole != 0 && cr.DenDefenseGeneration == Game.DenDefenseGeneration && Game.DenDefenseGeneration > 0;
}

bool IsCompanion(Critter cr)
{
    return IsActor(cr) && cr.DenDefenseRole == ROLE_COMPANION;
}

bool IsWaveEnemy(Critter cr)
{
    return IsActor(cr) && cr.DenDefenseRole == ROLE_ENEMY;
}

// Ослабляем весь рукопашный урон врагов волны, а не только бонус от силы.
int ScaleEnemyMeleeDamage(Critter cr, int damage)
{
    return IsActor(cr) && cr.DenDefenseRole == ROLE_ENEMY ? Math::Max(1, damage * 34 / 100) : damage;
}

// Применяется один раз при создании: меняем итоговый максимум, сохраняя формулу характеристик.
void ScaleSpawnHealth(Critter cr, int percent)
{
    int maxLife = cr.MaxLife;
    cr.MaxLifeBase += Math::Max(1, maxLife * percent / 100) - maxLife;
    cr.CurrentHp = cr.MaxLife;
}

bool IsPrimary(Critter cr)
{
    return IsParticipant(cr) && cr.Id == Game.DenDefensePrimaryId;
}

// Возвращаемый движком Player важен: при переподключении это не обязательно входной объект.
// Вызов находится вне catch, который откатывает ещё не зарегистрированного персонажа.
void OnSuccessfulLogin(Player player)
{
    Critter? cr = player.GetControlledCritter();
    verify(cr != null, "Confirmed login must have a controlled critter", player);

    // Загруженный мёртвый хозяин тоже означает провал: JoinAttempt не вправе его оживить в старом бое.
    if (Game.DenDefenseGeneration > 0 && Game.DenDefenseStage != STAGE_FAILED) {
        CheckDefenders();
    }
    if (Game.DenDefenseGeneration == 0 || Game.DenDefenseStage == STAGE_FAILED) {
        try {
            StartAttempt(cr);
        }
        catch {
            Game.DenDefenseStage = STAGE_FAILED;
            throw("Unable to initialize confirmed Sierra siege entry", cr.Id, GetExceptionInfo());
        }
        return;
    }

    JoinAttempt(cr);
}

void JoinAttempt(Critter cr)
{
    bool firstEntry = cr.DenDefenseGeneration != Game.DenDefenseGeneration;
    if (cr.IsDead()) {
        // Сначала оставляем вещи в месте смерти. Без карты сохраняем их до безопасного переноса.
        if (!SpillLoot(cr)) {
            verify(PlacePlayer(cr), "Unable to map dead participant for safe inventory spill", cr);
            verify(SpillLoot(cr), "Unable to spill participant inventory", cr);
        }
        // Тело могло быть занято другим живым криттером: оживаем уже на свободном гексе базы.
        verify(PlacePlayer(cr), "Unable to return dead participant to Sierra", cr);
        CritterState::ToAlive(cr);
        cr.CurrentHp = cr.MaxLife;
        cr.CurrentAp = cr.ActionPoints * Tla::AP_DIVIDER;
    }
    else if (firstEntry || cr.MapId != Game.DenDefenseMapId) {
        verify(PlacePlayer(cr), "Unable to place Sierra siege participant", cr);
    }
    if (firstEntry) {
        cr.CurrentHp = cr.MaxLife;
        cr.CurrentAp = cr.ActionPoints * Tla::AP_DIVIDER;
    }
    cr.DenDefenseGeneration = Game.DenDefenseGeneration;
    cr.ReplicationTime = -1;
    auto participants = Game.DenDefenseParticipantIds.clone();
    if (!participants.exists(cr.Id)) {
        participants.insertLast(cr.Id);
        Game.DenDefenseParticipantIds = participants;
    }
    cr.PlayerClientCall.DenDefenseTransition(Game.DenDefenseGeneration, 0);
    if (Game.DenDefenseStage == STAGE_RESTING) {
        cr.StopMoving();
        Dialogs::CloseDialog(cr);
        CritterActions::CloseContainerTransfer(cr);
        cr.PlayerClientCall.DenDefenseRestTransition(Game.DenDefenseGeneration, Game.DenDefenseRestPhase, RestRemaining());
    }
}

void StartAttempt(Critter primary)
{
    Map? map = GetBaseMap();
    verify(map != null, "Sierra entrance map is missing");

    // Сначала инвалидируем предыдущих акторов; только затем запускаем вложенные события.
    Game.DenDefenseGeneration = Game.DenDefenseGeneration + 1;
    Game.DenDefenseStage = STAGE_STARTING;
    Game.DenDefenseMapId = map.Id;
    Game.DenDefensePrimaryId = primary.Id;
    map.StopTimeEvent(Controller);
    map.StopTimeEvent(SpawnTick);
    Game.StopTimeEvent(FinishRest);
    Game.StopTimeEvent(StartAfterRest);
    Game.StopTimeEvent(CloseRestDialogs);
    Game.DenDefenseWave = 0;
    Game.DenDefenseSpawned = 0;
    Game.DenDefenseSpawnTotal = 0;
    Game.DenDefenseSpawnGroups = {};
    Game.DenDefenseRestPhase = 0;
    Game.DenDefenseSpawnRetries = 0;
    Game.DenDefenseRestUsed = false;
    Game.DenDefenseFailurePresented = false;
    Game.DenDefenseDawn = ZERO_SYNCTIME;
    Game.DenDefenseDawnLocked = false;
    auto oldEnemies = Game.DenDefenseEnemyHistory.clone();
    Game.DenDefenseEnemyHistory = {};
    Game.DenDefenseEnemyIds = {};
    for (int i = 0; i < oldEnemies.length(); i++) {
        Critter? old = Game.GetCritter(oldEnemies[i]);
        if (old != null) {
            DisposeActor(old, map);
        }
    }

    auto oldCompanions = Game.DenDefenseCompanionIds.clone();
    Game.DenDefenseCompanionIds = {};
    Game.DenDefenseParticipantIds = {};
    for (int i = 0; i < oldCompanions.length(); i++) {
        Critter? old = Game.GetCritter(oldCompanions[i]);
        if (old != null) {
            DisposeActor(old, map);
        }
    }

    // Смитти из старого Дэна остаётся в городе; ищем только обитателей входа Сьерры.
    Critter? smitty = null;
    Critter[] inhabitants = map.GetCritters(CritterFindType::Npc);
    for (int i = 0; i < inhabitants.length(); i++) {
        Critter cr = inhabitants[i];
        if (cr.ProtoId == Content::Critter::AutoCannon) {
            DisableTurret(cr, false);
        }
        else if (cr.DialogId == "den_defense_smitty".hstr() || cr.DialogId == Content::Dialog::den_smitty) {
            verify(smitty == null, "More than one Smitty on Sierra entrance");
            smitty = cr;
        }
        else if (cr.DialogId != "den_defense_todd".hstr()) {
            DisposeActor(cr, map);
        }
    }
    map.WarehouseTurretActive = false;
    // Сохранённая карта могла появиться до добавления авторского Смитти.
    if (smitty == null) {
        dict<CritterProperty, any> props = {{CritterProperty::BagId, int(Bags::Empty)},
                                            {CritterProperty::DialogId, "den_defense_smitty".hstr()},
                                            {CritterProperty::TeamId, 4}};
        smitty = map.AddCritter(Content::Critter::HomesteaderMale, mpos(37, 60), HDIR_Random, props);
    }
    verify(smitty != null, "Sierra Smitty is missing");
    Game.DenDefenseSmittyId = smitty.Id;
    SetupSmitty(smitty, map);
    DenCleanup::Setup(map);
    Item[] doors = map.GetItemsInRadius(mpos(40, 57), 0, Content::Item::door_2481);
    verify(doors.length() == 1, "Smitty workshop door is missing or ambiguous");
    Lockers::SwitchLocker(doors[0], true);
    JoinAttempt(primary);

    for (int i = 0; i < 4; i++) {
        CreateCompanion(primary, map, i);
    }

    // Уже подключённые участники остаются второстепенными без переподключения.
    Player[] online = Game.GetOnlinePlayers();
    for (int i = 0; i < online.length(); i++) {
        Critter? secondary = online[i].GetControlledCritter();
        if (secondary != null && secondary.Id != primary.Id) {
            JoinAttempt(secondary);
        }
    }

    Game.DenDefenseStage = STAGE_WAITING;
    map.StartTimeEvent(Time::Asap(), Time::Seconds(1), Controller, Game.DenDefenseGeneration);
    Game.Log("Sierra siege started, generation=" + Game.DenDefenseGeneration + " primary=" + primary.Id);
}

// Турели остаются декорацией: без штатного сканирования, боевых планов и реакции на урон.
void DisableTurret(Critter turret, bool firstTime)
{
    turret.StopTimeEvent(WarehouseTurret::TurretIdle);
    turret.OnCritterAppeared.Unsubscribe(WarehouseTurret::TurretShowCritter);
    turret.OnNpcPlaneBegin.Unsubscribe(WarehouseTurret::TurretBeginPlane);
    turret.SetupScript(null);
    turret.BagId = Bags::Empty;
    turret.StopTimeEvent(NpcBags::OnCritterIdle);
    turret.IsNoEnemyStack = true;
    turret.IsInvulnerable = true;
    turret.ReplicationTime = -1;
    NpcPlanes::DropPlanes(turret);
    EnemyStack::ClearEnemyStack(turret);
}

void SetupSmitty(Critter smitty, Map map)
{
    smitty.StopMoving();
    smitty.StopTimeEvent(Trader::UpdateItems);
    smitty.StopTimeEvent(NpcBags::OnCritterIdle);
    smitty.SetupScript(null);
    smitty.BagId = Bags::Empty;
    smitty.DenDefenseGeneration = Game.DenDefenseGeneration;
    smitty.DenDefenseRole = ROLE_SMITTY;
    smitty.ReplicationTime = -1;
    smitty.IsGeck = true;
    smitty.IsNoHome = true;
    smitty.IsNoKnock = true;
    smitty.IsNoEnemyStack = true;
    smitty.IsNoBarter = true;
    smitty.DialogId = "den_defense_smitty".hstr();
    smitty.TalkDistance = 5;
    smitty.MaxTalkers = 10;
    NpcPlanes::DropPlanes(smitty);
    EnemyStack::ClearEnemyStack(smitty);
    DenCleanup::StoreItems(smitty.GetItems(), map);
    PlaceSmittyAtHome(smitty, map);
    if (!smitty.IsAlive()) {
        CritterState::ToAlive(smitty);
    }
    Game.DestroyItems(smitty.GetItems());
    // Авторская модель nmpeas поддерживает пистолет, но не ружьё (CritterTypes.json).
    Item weapon = ItemStacks::AddItem(smitty, Content::Item::_10mm_pistol, 1);
    weapon.AmmoPid = Content::Item::_10mm_jhp;
    weapon.AmmoCount = weapon.Weapon_MaxAmmoCount;
    verify(CritterAnims::IsCritterStateAnim(smitty, weapon.Weapon_StateAnim), "Smitty weapon animation missing");
    smitty.ChangeItemSlot(weapon.Id, CritterItemSlot::Main);
    smitty.LastWeaponId = weapon.Id;
    smitty.LastWeaponUse = 0;
    smitty.LastWeaponNotFound = false;
    smitty.IsUnlimitedAmmo = true;
    ItemStacks::AddItem(smitty, Content::Item::stimpak, 2);
    smitty.CurrentHp = smitty.MaxLife;
    smitty.CurrentAp = smitty.ActionPoints * Tla::AP_DIVIDER;
}

void PlaceSmittyAtHome(Critter smitty, Map map)
{
    // Мастерская справа от грузовика; дверь находится на 40:57.
    mpos hex = mpos(37, 60);
    if (smitty.Hex != hex && !map.IsHexMovable(hex)) {
        const mpos[] homes = {mpos(36, 60), mpos(38, 60), mpos(37, 59), mpos(38, 59), mpos(36, 61), mpos(37, 61), mpos(38, 61)};
        for (int i = 0; i < homes.length(); i++) {
            if (map.IsHexMovable(homes[i])) {
                hex = homes[i];
                break;
            }
        }
    }
    verify(smitty.MapId == map.Id && IsWorkshopHex(hex) && (smitty.Hex == hex || map.IsHexMovable(hex)), "Smitty indoor home is blocked", hex);
    smitty.TransferToMap(map, hex, HDIR_Random);
    smitty.HomeMapId = map.Id;
    smitty.HomeHex = hex;
}

void CreateCompanion(Critter primary, Map map, int index)
{
    mpos hex = primary.Hex;
    verify(FindBaseSpawnHex(map, primary.Hex, 5, hex), "No reachable free hex for Den companion", index);
    bool leader = index == 0;
    dict<CritterProperty, any> props = {{CritterProperty::BagId, int(Bags::Empty)},
                                        {CritterProperty::DialogId, leader ? "den_defense_leader".hstr() : "den_defense_companion".hstr()},
                                        {CritterProperty::DenDefenseGeneration, Game.DenDefenseGeneration},
                                        {CritterProperty::DenDefenseRole, ROLE_COMPANION},
                                        {CritterProperty::TextArgs, TextFormatting::TextArg("merc_name", "@text Text Merc Name" + Game.Random(1, 29) + "@")},
                                        {CritterProperty::ReplicationTime, -1},
                                        // Итоговые ОЖ 103/91: ещё +50% к прежним 69/61, с округлением вниз.
                                        {CritterProperty::MaxLifeBase, index % 2 == 0 ? 70 : 58}};
    // Главный заменяет первого из четырёх спутников, не увеличивая силу отряда.
    hstring proto = leader ? "DenDefenseLeader".hstr() : "DenDefenseCompanion".hstr();
    Critter companion = map.AddCritter(proto, hex, HDIR_Random, props);
    // Main::CritterInit пересоздаёт Level/MaxLifeBase из регистрационных полей:
    // возвращаем уровень прототипа и добавляем заданный сценарием запас ОЖ к сгенерированной базе.
    companion.Level = Game.GetProtoCritter(proto).Level;
    companion.MaxLifeBase += int(props[CritterProperty::MaxLifeBase]);
    companion.CurrentHp = companion.MaxLife;
    companion.MakePersistent(true);
    auto ids = Game.DenDefenseCompanionIds.clone();
    ids.insertLast(companion.Id);
    Game.DenDefenseCompanionIds = ids;
    verify(Merc::Merc2Player(primary, companion, true, false, 0, 3, Merc::MERC_CUSTOM, true, true), "Unable to assign Den companion", companion);
    // Стартовые повышения дают очки и перк для ручного выбора хозяином, без автопрокачки.
    companion.UnspentSkillPoints = (companion.Level - 1) * (5 + companion.IntellectBase * 2);
    companion.UnspentPerks = companion.Level / 3;
    companion.StopTimeEvent(NpcBags::OnCritterIdle);
    companion.IsNoEnemyStack = true;
    companion.IsNoLoot = false;
    companion.IsNoSteal = false;
    companion.ReplicationTime = -1;
    const hstring[] weapons = {Content::Item::sledgehammer, Content::Item::combat_knife, Content::Item::crowbar, Content::Item::club};
    Item weapon = ItemStacks::AddItem(companion, weapons[index], 1);
    verify(CritterAnims::IsCritterStateAnim(companion, weapon.Weapon_StateAnim), "Companion weapon animation missing");
    companion.ChangeItemSlot(weapon.Id, CritterItemSlot::Main);
    ItemStacks::AddItem(companion, Content::Item::stimpak, 5);
}

// Считаем только обычных членов группы: исключение не расширяет вместимость машины.
int CapacityCount(Critter[] group)
{
    int count = 0;
    for (int i = 0; i < group.length(); i++) {
        if (!IsCompanion(group[i])) {
            count++;
        }
    }
    return count;
}

bool CanControlCompanion(Critter player, Critter npc)
{
    return IsPrimary(player) && player.IsAlive() && CanAct(player) && IsCompanion(npc) && npc.IsAlive() && npc.MercMasterId == player.Id &&
           npc.MapId == player.MapId;
}

[[DialogDemand]]
bool CanCommand(Critter player, Critter npc)
{
    return CanControlCompanion(player, npc);
}

[[DialogResult]]
void Follow(Critter player, Critter npc)
{
    if (CanControlCompanion(player, npc)) {
        Merc::SetBehaviorParameter(player, npc, CritterProperty::MercWaitForMaster, 0);
    }
}

[[DialogResult]]
void Wait(Critter player, Critter npc)
{
    if (CanControlCompanion(player, npc)) {
        Merc::SetBehaviorParameter(player, npc, CritterProperty::MercWaitForMaster, 1);
    }
}

[[DialogResult]]
void ToggleDefend(Critter player, Critter npc)
{
    if (CanControlCompanion(player, npc)) {
        Merc::SetBehaviorParameter(player, npc, CritterProperty::MercDefendMaster, npc.MercDefendMaster ? 0 : 1);
    }
}

[[DialogResult]]
void ToggleAssist(Critter player, Critter npc)
{
    if (CanControlCompanion(player, npc)) {
        Merc::SetBehaviorParameter(player, npc, CritterProperty::MercAssistMaster, npc.MercAssistMaster ? 0 : 1);
    }
}

bool CanChangeWeaponReadiness(Critter player, Critter npc, bool ready)
{
    return CanControlCompanion(player, npc) && npc.MercWeaponReady != ready;
}

[[DialogDemand]]
bool CanHolsterWeapons(Critter player, Critter npc)
{
    return CanChangeWeaponReadiness(player, npc, false);
}

[[DialogDemand]]
bool CanReadyWeapons(Critter player, Critter npc)
{
    return CanChangeWeaponReadiness(player, npc, true);
}

[[DialogResult]]
void HolsterWeapons(Critter player, Critter npc)
{
    if (CanChangeWeaponReadiness(player, npc, false)) {
        Merc::SetBehaviorParameter(player, npc, CritterProperty::MercWeaponReady, 0);
    }
}

[[DialogResult]]
void ReadyWeapons(Critter player, Critter npc)
{
    if (CanChangeWeaponReadiness(player, npc, true)) {
        Merc::SetBehaviorParameter(player, npc, CritterProperty::MercWeaponReady, 1);
    }
}

[[DialogResult]]
void CollectLoot(Critter player, Critter npc)
{
    if (!CanControlCompanion(player, npc)) {
        return;
    }
    mpos center = npc.Hex;
    MercLoot::Start(player, npc, center, 0);
    if (npc.NpcRole != Merc::ROLE_LEADER) {
        return;
    }

    // Разносим начало по времени; затем каждый сборщик отдельно резервирует свою цель.
    Critter[] mercs = {};
    Merc::GetPlayerMercs(player, mercs);
    int order = 1;
    for (int i = 0; i < mercs.length(); i++) {
        Critter follower = mercs[i];
        if (follower.Id != npc.Id && follower.IsAlive() && CanAct(follower)) {
            MercLoot::Start(player, follower, center, order * MercLoot::START_INTERVAL_SECONDS);
            order++;
        }
    }
}

[[DialogResult]]
void StoreLoot(Critter player, Critter npc)
{
    if (!CanControlCompanion(player, npc)) {
        return;
    }
    MercStorage::Start(player, npc);
    if (npc.NpcRole == Merc::ROLE_LEADER) {
        Critter[] mercs = {};
        Merc::GetPlayerMercs(player, mercs);
        for (int i = 0; i < mercs.length(); i++) {
            if (mercs[i].Id != npc.Id) {
                MercStorage::Start(player, mercs[i]);
            }
        }
    }
}

// При провале игроки могут только выйти и войти заново; обычные городские NPC не замораживаются.
bool CanAct(Critter cr)
{
    if (Game.DenDefenseGeneration == 0) {
        return true;
    }
    if (cr.ControlledByPlayer || IsActor(cr)) {
        return Game.DenDefenseStage != STAGE_FAILED && Game.DenDefenseStage != STAGE_RESTING;
    }
    return true;
}

bool UsesFiniteAmmo(Critter cr)
{
    return IsActor(cr) && cr.DenDefenseRole == ROLE_ENEMY;
}

// Переносим только реальные оставшиеся вещи. Слитые стопки и содержимое контейнеров не копируем.
bool SpillLoot(Critter cr)
{
    Map? map = cr.GetMap();
    if (map == null) {
        return false;
    }
    Item[] items = cr.GetItems();
    for (int i = 0; i < items.length(); i++) {
        Item item = items[i];
        if (!item.Hidden && !item.IsGag) {
            Item? placed = ItemStacks::MoveItem(item, item.Count, map, cr.Hex);
            verify(placed != null && placed.Ownership == ItemOwnership::MapHex && placed.MapId == map.Id, "Inventory spill failed", cr);
        }
    }
    // Вложенные обработчики переноса не должны оставить новые обычные вещи перед удалением тела.
    auto remaining = cr.GetItems();
    for (int i = 0; i < remaining.length(); i++) {
        verify(remaining[i].Hidden || remaining[i].IsGag, "Inventory changed during spill", cr, remaining[i]);
    }
    return true;
}

void DisposeActor(Critter cr, Map base)
{
    cr.StopMoving();
    NpcPlanes::DropPlanes(cr);
    if (cr.GetMap() == null) {
        mpos hex = mpos(43, 55);
        verify(Entrance::GetFreeHex(base, 6, hex), "No safe map hex for obsolete actor loot", cr);
        cr.TransferToMap(base, hex, HDIR_Random);
    }
    verify(SpillLoot(cr), "Refusing to delete unmapped actor and inventory", cr);
    Game.DestroyCritter(cr);
}

// Внутренность мастерской: стены x=32/48, y=57/69; дверь и улица не входят.
bool IsWorkshopHex(mpos hex)
{
    return hex.x >= 33 && hex.x <= 47 && hex.y >= 58 && hex.y <= 68;
}

bool IsScenarioCombat(Critter first, Critter second)
{
    return IsActor(first) || IsActor(second);
}

bool CanAttack(Critter attacker, Critter target)
{
    if (!CanAct(attacker)) {
        return false;
    }
    if (!IsScenarioCombat(attacker, target)) {
        return true;
    }
    if (attacker.MapId != Game.DenDefenseMapId || target.MapId != attacker.MapId) {
        return false;
    }
    if ((!IsActor(attacker) && !IsParticipant(attacker)) || (!IsActor(target) && !IsParticipant(target))) {
        return false;
    }
    if (IsActor(attacker)) {
        bool attackerEnemy = attacker.DenDefenseRole == ROLE_ENEMY;
        bool targetEnemy = IsActor(target) && target.DenDefenseRole == ROLE_ENEMY;
        bool smittyRetaliates = attacker.DenDefenseRole == ROLE_SMITTY && EnemyStack::CheckEnemyInStack(attacker, target.Id);
        if (attackerEnemy == targetEnemy && !smittyRetaliates) {
            return false;
        }
    }
    if (!DenWander::CanAttack(attacker, target)) {
        return false;
    }
    if (IsActor(attacker) && attacker.DenDefenseRole == ROLE_SMITTY) {
        return IsWorkshopHex(attacker.Hex) && IsWorkshopHex(target.Hex);
    }
    if (IsActor(target) && target.DenDefenseRole == ROLE_SMITTY) {
        return IsWorkshopHex(target.Hex);
    }
    return true;
}

// Проверяем фактическую жертву промаха, очереди или взрыва; самоурон и среда не являются атакой другой цели.
bool CanDamage(Critter? attacker, Critter target)
{
    if (attacker == null || attacker.Id == target.Id) {
        return true;
    }
    return CanAttack(attacker, target);
}

bool IsSmittyDialog(Critter player, Critter npc)
{
    return IsParticipant(player) && player.IsAlive() && IsActor(npc) && npc.Id == Game.DenDefenseSmittyId && npc.IsAlive() &&
           player.MapId == Game.DenDefenseMapId && npc.MapId == player.MapId && CanAct(player);
}

bool CanRestNow(Critter player, Critter npc)
{
    return IsSmittyDialog(player, npc) && Game.DenDefenseStage == STAGE_WAITING && !Game.DenDefenseRestUsed &&
           player.DenDefenseKitGeneration == Game.DenDefenseGeneration && Game.DenDefenseWave < 3;
}

[[DialogDemand]]
bool CanRest(Critter player, Critter npc)
{
    return CanRestNow(player, npc);
}

[[DialogResult]]
void Brief(Critter player, Critter npc)
{
    if (!IsSmittyDialog(player, npc) || player.DenDefenseKitGeneration == Game.DenDefenseGeneration) {
        return;
    }
    player.DenDefenseKitGeneration = Game.DenDefenseGeneration;
    ItemStacks::AddItem(player, Content::Item::crowbar, 1);
    ItemStacks::AddItem(player, Content::Item::stimpak, 2);
    ItemStacks::AddItem(player, Content::Item::leather_jacket, 1);
}

bool CanClaimRewardNow(Critter player, Critter npc)
{
    return IsSmittyDialog(player, npc) && Game.DenDefenseStage == STAGE_VICTORY && player.DenDefenseRewardGeneration != Game.DenDefenseGeneration;
}

[[DialogDemand]]
bool CanClaimReward(Critter player, Critter npc)
{
    return CanClaimRewardNow(player, npc);
}

[[DialogResult]]
void ClaimReward(Critter player, Critter npc)
{
    if (!CanClaimRewardNow(player, npc)) {
        return;
    }
    player.DenDefenseRewardGeneration = Game.DenDefenseGeneration;
    ItemStacks::AddItem(player, Content::Item::car_fuel_injection, 1);
}

void StopScenarioActions()
{
    GlobalmapGroup::StopScenarioTravel();
    auto actors = Game.DenDefenseParticipantIds.clone();
    actors.insertLast(Game.DenDefenseCompanionIds);
    actors.insertLast(Game.DenDefenseEnemyIds);
    actors.insertLast(Game.DenDefenseSmittyId);
    for (int i = 0; i < actors.length(); i++) {
        Critter? cr = Game.GetCritter(actors[i]);
        if (cr != null) {
            cr.StopMoving();
            if (!cr.ControlledByPlayer) {
                MercStorage::Cancel(cr);
                NpcPlanes::DropPlanes(cr);
            }
        }
    }
}

[[DialogResult]]
void Rest(Critter player, Critter npc)
{
    if (!CanRestNow(player, npc)) {
        return;
    }
    Game.DenDefenseRestUsed = true;
    Game.DenDefenseStage = STAGE_RESTING;
    Game.DenDefenseRestPhase = 0;
    Game.DenDefenseRestUntil = Game.FrameTime + Time::Seconds(1);
    Game.DenDefenseDawn = GameTime::GetNearSynchronizedTime(0, 0, 0, 10, 0, 0);
    Game.DenDefenseDawnLocked = false;
    StopScenarioActions();
    Game.StartTimeEvent(Time::Milliseconds(1), CloseRestDialogs, Game.DenDefenseGeneration);
    BroadcastRest(0);
    Game.StartTimeEvent(Time::Seconds(1), FinishRest, Game.DenDefenseGeneration);
}

[[TimeEvent]]
void FinishRest(any value)
{
    if (int(value) != Game.DenDefenseGeneration || Game.DenDefenseStage != STAGE_RESTING) {
        return;
    }
    if (!CheckDefenders() || CancelRestWithoutSmitty()) {
        return;
    }
    if (Game.DenDefenseRestPhase != 0) {
        return;
    }
    if (!Game.DenDefenseDawnLocked) {
        // Утро могло пройти во время затемнения или простоя сервера. До первого скачка
        // выбираем будущий 10:00; после фиксации повторный вызов не выбирает следующие сутки.
        if (Game.DenDefenseDawn <= Game.SynchronizedTime) {
            Game.DenDefenseDawn = GameTime::GetNearSynchronizedTime(0, 0, 0, 10, 0, 0);
        }
        Game.DenDefenseDawnLocked = true;
    }
    GameTime::AdvanceCalendarTo(Game.DenDefenseDawn);
    auto ids = Game.DenDefenseParticipantIds.clone();
    ids.insertLast(Game.DenDefenseCompanionIds);
    ids.insertLast(Game.DenDefenseSmittyId);
    for (int i = 0; i < ids.length(); i++) {
        Critter? cr = Game.GetCritter(ids[i]);
        if (cr != null && !cr.IsDead()) {
            cr.CurrentHp = cr.MaxLife;
            cr.CurrentAp = cr.ActionPoints * Tla::AP_DIVIDER;
        }
    }
    Game.DenDefenseRestPhase = 1;
    Game.DenDefenseRestUntil = Game.FrameTime + Time::Seconds(1);
    BroadcastRest(1);
    Game.StartTimeEvent(Time::Seconds(1), StartAfterRest, Game.DenDefenseGeneration);
}

timespan RestRemaining()
{
    return Game.DenDefenseRestUntil > Game.FrameTime ? Game.DenDefenseRestUntil - Game.FrameTime : Time::Milliseconds(0);
}

void BroadcastRest(int phase)
{
    auto online = Game.GetOnlinePlayers();
    for (int i = 0; i < online.length(); i++) {
        online[i].ClientCall.DenDefenseRestTransition(Game.DenDefenseGeneration, phase, RestRemaining());
    }
}

[[TimeEvent]]
void CloseRestDialogs(any value)
{
    if (int(value) != Game.DenDefenseGeneration || Game.DenDefenseStage != STAGE_RESTING) {
        return;
    }
    auto online = Game.GetOnlinePlayers();
    for (int i = 0; i < online.length(); i++) {
        Critter? cr = online[i].GetControlledCritter();
        if (cr != null) {
            Dialogs::CloseDialog(cr);
            CritterActions::CloseContainerTransfer(cr);
        }
    }
}

[[TimeEvent]]
void StartAfterRest(any value)
{
    if (int(value) != Game.DenDefenseGeneration || Game.DenDefenseStage != STAGE_RESTING || Game.DenDefenseRestPhase != 1) {
        return;
    }
    if (!CheckDefenders() || CancelRestWithoutSmitty()) {
        return;
    }
    Map? map = Game.GetMap(Game.DenDefenseMapId);
    verify(map != null, "Sierra entrance disappeared after rest");
    // Пока поколение и история прошлой волны ещё действуют, завершаем перенос тел без двойного счёта.
    DenCleanup::BeforeWave(map);
    Game.DenDefenseStage = STAGE_FIGHTING;
    BroadcastRest(2);
    Game.DenDefenseWave = Game.DenDefenseWave + 1;
    Game.DenDefenseSpawned = 0;
    Game.DenDefenseSpawnTotal = Game.DenDefenseWave == 2 ? 30 : 44;
    int[] groups = {};
    if (Game.DenDefenseWave == 1) {
        Game.DenDefenseSpawnTotal = 0;
        // Сохраняем 50 выходов, но каждый теперь даёт равновероятную группу из 1..3 врагов.
        // Размер заранее выбранной группы не меняется при повторе из-за занятой зоны выхода.
        for (int i = 0; i < 50; i++) {
            int size = Game.Random(1, 3);
            groups.insertLast(size);
            Game.DenDefenseSpawnTotal = Game.DenDefenseSpawnTotal + size;
        }
    }
    Game.DenDefenseSpawnGroups = groups;
    Game.DenDefenseEnemyIds = {};
    map.StopTimeEvent(SpawnTick);
    Game.DenDefenseDawn = ZERO_SYNCTIME;
    Game.Log("Sierra siege wave started, generation=" + Game.DenDefenseGeneration + " wave=" + Game.DenDefenseWave + " total=" + Game.DenDefenseSpawnTotal);
    // Первую группу выпускаем сразу, остальные — по таймеру карты.
    map.StopTimeEvent(Controller);
    map.StartTimeEvent(Time::Seconds(1), Time::Seconds(1), Controller, Game.DenDefenseGeneration);
    SpawnBatch();
}

// При каждом запуске сбрасываем осаду; сохранённые персонажи начинают её новым входом.
[[Event]]
void ResumeController()
{
    // Останавливаем также контроллер прежней базы из сохранения до смены карты.
    Map? previous = Game.GetMap(Game.DenDefenseMapId);
    if (previous != null) {
        previous.StopTimeEvent(Controller);
        previous.StopTimeEvent(SpawnTick);
    }
    if (Game.GetLocation(Content::Location::sierra_army_depot) == null) {
        Location::CreateLocation(Content::Location::sierra_army_depot, ipos(914, 814), null);
    }
    Map? map = GetBaseMap();
    verify(map != null, "Sierra entrance map is missing at server start");
    // Движок создаёт локации временными; сохраняем базу вместе с её картой и содержимым.
    map.GetLocation().MakePersistent(true);
    // Сама осада сбрасывается, но уже поднятое Тоддом тело не теряется при рестарте.
    DenCleanup::DeliverCarried(map);
    map.WarehouseTurretActive = false;
    Critter[] turrets = map.GetCritters(Content::Critter::AutoCannon, CritterFindType::Npc);
    for (int i = 0; i < turrets.length(); i++) {
        DisableTurret(turrets[i], false);
    }
    map.StopTimeEvent(Controller);
    map.StopTimeEvent(SpawnTick);
    Game.StopTimeEvent(CloseRestDialogs);
    Game.StopTimeEvent(FinishRest);
    Game.StopTimeEvent(StartAfterRest);
    Game.DenDefenseStage = STAGE_FAILED;
    StopScenarioActions();
    Game.DenDefenseWave = 0;
    Game.DenDefenseSpawned = 0;
    Game.DenDefenseSpawnTotal = 0;
    Game.DenDefenseSpawnGroups = {};
    Game.DenDefenseSpawnRetries = 0;
    Game.DenDefenseRestUsed = false;
    Game.DenDefenseRestPhase = 0;
    Game.DenDefenseRestUntil = ZERO_NANOTIME;
    Game.DenDefenseDawn = ZERO_SYNCTIME;
    Game.DenDefenseDawnLocked = false;
    Game.DenDefenseFailurePresented = false;
    map.DenDefenseNextSpawn = ZERO_NANOTIME;
    // Сохраняем поколение и списки актёров: StartAttempt уберёт старый отряд и врагов,
    // а новое поколение отделит прежние отметки участия, выдачи припасов и наград.
    Game.Log("Sierra siege reset on server start, generation=" + Game.DenDefenseGeneration + " wave=" + Game.DenDefenseWave);
}

[[TimeEvent]]
void Controller(Map map, any value)
{
    if (map.Id != Game.DenDefenseMapId || int(value) != Game.DenDefenseGeneration || Game.DenDefenseStage == STAGE_FAILED ||
        Game.DenDefenseStage == STAGE_STARTING) {
        return;
    }
    if (Game.GetMap(Game.DenDefenseMapId) == null) {
        FailAttempt();
        return;
    }
    if (Game.DenDefenseStage == STAGE_RESTING) {
        return;
    }
    if (!CheckDefenders()) {
        return;
    }
    Critter? smitty = Game.GetCritter(Game.DenDefenseSmittyId);
    verify(smitty != null, "Validated Smitty disappeared");
    PatternCommon::CommonPattern helpers = PatternCommon::CommonPattern();
    if (smitty.IsAlive()) {
        helpers.TryUseStim(smitty);
        ChooseTarget(smitty);
    }
    if (Game.DenDefenseStage != STAGE_FIGHTING) {
        return;
    }
    auto enemies = Game.DenDefenseEnemyIds.clone();
    for (int i = 0; i < enemies.length(); i++) {
        Critter? enemy = Game.GetCritter(enemies[i]);
        if (enemy == null || enemy.MapId != map.Id || !IsActor(enemy)) {
            Game.Log("Den defense outstanding enemy disappeared or left its map, id=" + enemies[i]);
            FailAttempt();
            return;
        }
        if (enemy.IsDead()) {
            ConfirmEnemyDeath(enemy);
        }
        else {
            ChooseTarget(enemy);
        }
    }
    if (Game.DenDefenseSpawned == Game.DenDefenseSpawnTotal && Game.DenDefenseEnemyIds.isEmpty()) {
        CompleteWave();
    }
}

// Отдельный таймер не округляет случайные миллисекундные интервалы до тика контроллера.
[[TimeEvent]]
void SpawnTick(Map map, any value)
{
    if (int(value) == Game.DenDefenseGeneration && map.Id == Game.DenDefenseMapId && Game.DenDefenseStage == STAGE_FIGHTING &&
        Game.DenDefenseSpawned < Game.DenDefenseSpawnTotal) {
        SpawnBatch();
    }
}

void SpawnBatch()
{
    Map? map = Game.GetMap(Game.DenDefenseMapId);
    verify(map != null, "Sierra entrance disappeared during spawn");
    // Вся авторская зона выхода в мир, включая MultihexMesh, а не точки у её центра.
    // Вход в подземелье sad_level1 к глобальному выходу не относится.
    mpos[] approaches = {};
    StaticItem[] grids = map.GetStaticItems();
    for (int i = 0; i < grids.length(); i++) {
        StaticItem grid = grids[i];
        if (grid.ProtoId == Content::Item::ExitGrid && grid.Grid_ToMap.str.isEmpty()) {
            approaches.insertLast(grid.Hex);
            approaches.insertLast(grid.MultihexMesh);
        }
    }
    verify(!approaches.isEmpty(), "Sierra global exit zone is missing");
    verify(Game.DenDefenseWave != 1 || !Game.DenDefenseSpawnGroups.isEmpty(), "Missing Den wave-1 spawn group");
    int batchSize = Game.DenDefenseWave == 1 ? Game.DenDefenseSpawnGroups[0] : (Game.DenDefenseWave == 2 ? 3 : 1);
    verify(batchSize >= 1 && batchSize <= 3 && Game.DenDefenseSpawnTotal - Game.DenDefenseSpawned >= batchSize, "Invalid Den spawn batch size");
    Critter? smitty = Game.GetCritter(Game.DenDefenseSmittyId);
    verify(smitty != null, "Smitty disappeared during spawn");
    mpos[] candidates = {};
    // Всю группу создаём только при достаточном числе свободных достижимых гексов.
    for (int i = 0; i < approaches.length(); i++) {
        mpos candidate = approaches[i];
        if (!candidates.exists(candidate) && map.IsHexMovable(candidate) && map.GetCritterOnHex(candidate) == null &&
            map.GetPathLength(candidate, smitty.Hex, 1 + smitty.Multihex, CanLeaveSpawnHouse) > 0) {
            candidates.insertLast(candidate);
        }
    }
    // Первая/третья волны: 3..9 с, вторая: 9..27 с между тройками (среднее 18 с).
    int intervalScale = Game.DenDefenseWave == 2 ? 3 : 1;
    timespan interval = Time::Milliseconds(Game.Random(3000 * intervalScale, 9000 * intervalScale));
    map.DenDefenseNextSpawn = Game.FrameTime + interval;
    map.StartTimeEvent(interval, SpawnTick, Game.DenDefenseGeneration);
    if (candidates.length() < batchSize) {
        Game.DenDefenseSpawnRetries = Game.DenDefenseSpawnRetries + 1;
        if (Game.DenDefenseSpawnRetries % 5 == 1) {
            Game.Log("Sierra siege exit zone occupied or unreachable, cursor=" + Game.DenDefenseSpawned + " generation=" + Game.DenDefenseGeneration);
        }
        return;
    }
    Game.DenDefenseSpawnRetries = 0;
    for (int i = 0; i < batchSize; i++) {
        int index = Game.Random(0, candidates.length() - 1);
        mpos hex = candidates[index];
        candidates.removeAt(index);
        SpawnEnemy(map, hex);
    }
    if (Game.DenDefenseWave == 1) {
        auto groups = Game.DenDefenseSpawnGroups.clone();
        groups.removeAt(0);
        Game.DenDefenseSpawnGroups = groups;
    }
}

void SpawnEnemy(Map map, mpos hex)
{
    int cursor = Game.DenDefenseSpawned;
    int brother = Game.DenDefenseWave == 3 && cursor >= Game.DenDefenseSpawnTotal - 2 ? cursor - Game.DenDefenseSpawnTotal + 3 : 0;
    hstring proto;
    if (Game.DenDefenseWave == 1) {
        // Местные Проститутка (nftrmp), Алкоголик и Псих (nmlosr), как в den.fomap.
        proto = cursor % 3 == 0 ? Content::Critter::Loser2 : Content::Critter::Loser;
    }
    else if (Game.DenDefenseWave == 2) {
        proto = cursor % 2 == 0 ? Content::Critter::Wilder : Content::Critter::Wilder2;
    }
    else {
        const hstring[] townspeople = {Content::Critter::WeakPeasant,
                                       Content::Critter::AveragePeasant,
                                       Content::Critter::HomesteaderMale,
                                       Content::Critter::HomesteaderFemale};
        // Тот же MasterTrader/nmpeas, что у Дантона на авторской карте Кламата.
        proto = brother > 0 ? Content::Critter::MasterTrader : townspeople[cursor % townspeople.length()];
    }
    // Штатные реплики проститутки / зависимых, племени, бандитов и горожан.
    // Таблицы звуков и анимаций наследуются от моделей; общие прото и AiSettings не меняем.
    int aiId = Game.DenDefenseWave == 1 ? (cursor % 3 == 0 ? 45 : 11) : (Game.DenDefenseWave == 2 ? 1 : (brother > 0 ? 13 : 14));
    dict<CritterProperty, any> props = {{CritterProperty::BagId, int(Bags::Empty)},
                                        {CritterProperty::AiId, aiId},
                                        {CritterProperty::ReplicationTime, -1},
                                        {CritterProperty::DenDefenseGeneration, Game.DenDefenseGeneration},
                                        {CritterProperty::DenDefenseRole, ROLE_ENEMY},
                                        {CritterProperty::DenDefenseBrother, brother},
                                        {CritterProperty::TeamId, int(Teams::Mob0)}};
    Critter enemy = map.AddCritter(proto, hex, HDIR_Random, props);
    // Удвоенный пул опыта только для врагов осады, без изменения общих прототипов.
    enemy.KillExperience *= 2;
    // Первая волна: ещё вдвое меньше прежних 50%; остальные волны без изменений.
    ScaleSpawnHealth(enemy, Game.DenDefenseWave == 1 ? 25 : 50);
    if (cursor == 0) {
        Game.Log("Den defense first enemy spawned, wave=" + Game.DenDefenseWave + " id=" + enemy.Id + " hex=" + hex.x + ":" + hex.y);
    }
    auto enemies = Game.DenDefenseEnemyIds.clone();
    enemies.insertLast(enemy.Id);
    Game.DenDefenseEnemyIds = enemies;
    auto history = Game.DenDefenseEnemyHistory.clone();
    history.insertLast(enemy.Id);
    Game.DenDefenseEnemyHistory = history;
    Game.DenDefenseSpawned = Game.DenDefenseSpawned + 1;
    enemy.StopTimeEvent(NpcBags::OnCritterIdle);
    enemy.IsNoHome = true;
    enemy.IsNoEnemyStack = true;
    enemy.IsNoLoot = false;
    enemy.IsNoSteal = false;
    enemy.IsUnlimitedAmmo = false;
    enemy.IsGeck = true;
    if (Game.DenDefenseWave == 1) {
        const hstring[] dialogs = {Content::Dialog::all_prostitute, Content::Dialog::all_alco, Content::Dialog::den_crazy_man};
        enemy.DialogId = dialogs[cursor % dialogs.length()];
        // Сумки 26/11 — те же, что у этих жителей den.fomap. Наполняем один раз,
        // не включая обновление сумки и не копируя квестовое состояние городских NPC.
        auto bagItems = NpcBags::GetBag(cursor % 3 == 0 ? 26 : 11).GetBagItems();
        for (int i = 0; i < bagItems.length(); i++) {
            bagItems[i].AddCritterItem(enemy);
        }
        if (cursor % 3 == 1) {
            ItemStacks::AddItem(enemy, cursor % 2 == 0 ? Content::Item::beer : Content::Item::booze, 1);
            ItemStacks::AddItem(enemy, Content::Item::rock, Game.Random(1, 3));
        }
    }
    else if (Game.DenDefenseWave == 2) {
        if (cursor < 6) {
            Item spear = ItemStacks::AddItem(enemy, Content::Item::spear, 1);
            enemy.ChangeItemSlot(spear.Id, CritterItemSlot::Main);
        }
        const hstring[] tribalLoot = {Content::Item::meat, Content::Item::flower, Content::Item::healing_powder};
        ItemStacks::AddItem(enemy, tribalLoot[cursor % tribalLoot.length()], 1);
    }
    else {
        const hstring[] drinks = {Content::Item::beer, Content::Item::booze, Content::Item::gamma_gulp_beer, Content::Item::roentgen_rum};
        const hstring[] junk = {Content::Item::rope, Content::Item::rubber_boots, Content::Item::mutated_fruit};
        ItemStacks::AddItem(enemy, drinks[cursor % drinks.length()], 1);
        ItemStacks::AddItem(enemy, junk[cursor % junk.length()], 1);
        if (Game.DenDefenseWave == 3) {
            ItemStacks::AddItem(enemy, Content::Item::bottle_caps, Game.Random(1, 10));
        }
    }
    if (brother > 0) {
        enemy.DialogId = (brother == 1 ? "den_defense_bobby" : "den_defense_billy").hstr();
        // У nmpeas нет J (ружьё), зато есть E (пистолет); сохраняем пять конечных патронов.
        Item pistol = ItemStacks::AddItem(enemy, Content::Item::_10mm_pistol, 1);
        pistol.DenDefenseFiniteAmmo = true;
        pistol.AmmoPid = Content::Item::_10mm_jhp;
        pistol.AmmoCount = 1;
        ItemStacks::AddItem(enemy, Content::Item::_10mm_jhp, 4);
        verify(CritterAnims::IsCritterStateAnim(enemy, pistol.Weapon_StateAnim), "Dunton pistol animation missing");
        enemy.ChangeItemSlot(pistol.Id, CritterItemSlot::Main);
        enemy.LastWeaponId = pistol.Id;
        enemy.LastWeaponUse = 0;
        enemy.LastWeaponNotFound = false;
        ItemStacks::AddItem(enemy, Content::Item::brass_knuckles, 1);
    }
    DenWander::TryStart(enemy);
    ChooseTarget(enemy);
}

// До создания NPC ключей у него нет; все пакеты ИИ волн умеют открывать двери.
bool CanLeaveSpawnHouse(Item obstacle)
{
    return obstacle.Type == ItemType::Door && !obstacle.Locker_NoOpen && obstacle.LockerId == 0;
}

void ChooseTarget(Critter npc)
{
    Map? map = npc.GetMap();
    verify(map != null && map.Id == Game.DenDefenseMapId, "Scenario actor left Den", npc);
    bool enemy = npc.DenDefenseRole == ROLE_ENEMY;
    if (enemy && DenWander::Process(npc, map)) {
        return;
    }
    Critter? best = null;
    int distance = 100000;
    auto candidates = enemy ? Game.DenDefenseParticipantIds.clone() : Game.DenDefenseEnemyIds.clone();
    if (enemy) {
        candidates.insertLast(Game.DenDefenseCompanionIds);
    }
    else if (npc.DenDefenseRole == ROLE_SMITTY) {
        // Помним напавшего игрока/спутника: обычный тик обороны не стирает ответную атаку.
        candidates.insertLast(npc.EnemyStack);
    }
    for (int i = 0; i < candidates.length(); i++) {
        Critter? candidate = Game.GetCritter(candidates[i]);
        if (candidate == null || candidate.IsDead() || !CanAttack(npc, candidate) || !npc.IsSee(candidate)) {
            continue;
        }
        int current = Game.GetDistance(npc, candidate);
        int cut = 1 + npc.Multihex + candidate.Multihex;
        if (current < distance && (!enemy || current <= cut || map.GetPathLength(npc, candidate.Hex, cut, MainPlanes::CanOpenDoor) > 0)) {
            distance = current;
            best = candidate;
        }
    }
    // Улица, скрывшийся защитник и недоступный игрок не заменяют главную цель — мастерскую.
    Critter? smitty = enemy ? Game.GetCritter(Game.DenDefenseSmittyId) : null;
    if (best == null && smitty != null && smitty.IsAlive() && CanAttack(npc, smitty) && npc.IsSee(smitty)) {
        best = smitty;
    }
    auto plans = NpcPlanes::GetPlanes(npc);
    if (best != null) {
        if (plans != null && plans[0].Type == NpcPlanes::AI_PLANE_ATTACK && plans[0].Attack_TargId == best.Id) {
            return; // Не сбрасываем выполняющийся дочерний план открытия двери/обхода заслона.
        }
        npc.StopMoving();
        NpcPlanes::DropPlanes(npc);
        NpcPlanes::AddAttackPlane(npc, 0, best);
    }
    else if (smitty != null && smitty.IsAlive()) {
        if (plans != null && plans[0].Type == NpcPlanes::AI_PLANE_WALK && plans[0].Walk_Hex == smitty.Hex) {
            return;
        }
        npc.StopMoving();
        NpcPlanes::DropPlanes(npc);
        NpcPlanes::AddWalkPlane(npc, 0, smitty.Hex, Game.GetDirection(npc.Hex, smitty.Hex), false, 1);
    }
    else if (plans != null && plans[0].Type == NpcPlanes::AI_PLANE_ATTACK) {
        // Нет боевой цели — снимаем только боевую задачу, не обрывая следование хозяину.
        npc.StopMoving();
        NpcPlanes::DropPlanes(npc);
    }
}

// Именно фактический выстрел: не выбор оружия и не попытка перезарядки.
void OnWeaponFired(Critter cr, AbstractItem weapon, ProtoItem? ammo)
{
    if (IsActor(cr) && cr.DenDefenseBrother > 0 && weapon.ProtoId == Content::Item::_10mm_pistol && ammo != null) {
        Messaging::SayShoutOnHead(cr, MsgStr::DialogTextKey(cr.DialogId, Game.Random(100, 103)));
    }
}

void CompleteWave()
{
    Game.DenDefenseStage = Game.DenDefenseWave == 3 ? STAGE_VICTORY : STAGE_WAITING;
    Game.DenDefenseRestUsed = false;
    Game.Log("Den defense wave cleared, generation=" + Game.DenDefenseGeneration + " wave=" + Game.DenDefenseWave);
}

// Выгруженный хозяин не передаёт лидерство; смерть Смитти оставляет мир доступным.
bool CheckDefenders()
{
    Critter? primary = Game.GetCritter(Game.DenDefensePrimaryId);
    Critter? smitty = Game.GetCritter(Game.DenDefenseSmittyId);
    if ((primary != null && primary.IsDead()) || smitty == null || smitty.MapId != Game.DenDefenseMapId) {
        FailAttempt();
        return false;
    }
    return true;
}

void FailAttempt()
{
    if (Game.DenDefenseStage == STAGE_FAILED) {
        return;
    }
    Game.DenDefenseStage = STAGE_FAILED;
    Game.StopTimeEvent(FinishRest);
    Game.StopTimeEvent(StartAfterRest);
    Map? map = Game.GetMap(Game.DenDefenseMapId);
    if (map != null) {
        map.StopTimeEvent(Controller);
        map.StopTimeEvent(SpawnTick);
    }
    StopScenarioActions();
    BroadcastRest(2);
    auto online = Game.GetOnlinePlayers();
    for (int i = 0; i < online.length(); i++) {
        online[i].ClientCall.DenDefenseTransition(Game.DenDefenseGeneration, 1);
    }
    // Оставляем труп на карте: вещи выпадают через HandleCritterDeath,
    // а новое поколение и оживление запускаются только подтверждённым входом.
    Game.Log("Den defense failed, generation=" + Game.DenDefenseGeneration);
}

// Смерть Смитти не замораживает мир и не начинает новую попытку при следующем входе.
// Если она случилась во время отдыха, снимаем затемнение без запуска следующей волны.
bool CancelRestWithoutSmitty()
{
    Critter? smitty = Game.GetCritter(Game.DenDefenseSmittyId);
    if (Game.DenDefenseStage != STAGE_RESTING || smitty == null || !smitty.IsDead()) {
        return false;
    }
    Game.StopTimeEvent(FinishRest);
    Game.StopTimeEvent(StartAfterRest);
    Game.StopTimeEvent(CloseRestDialogs);
    Game.DenDefenseStage = STAGE_WAITING;
    Game.DenDefenseRestUntil = ZERO_NANOTIME;
    Game.DenDefenseDawn = ZERO_SYNCTIME;
    Game.DenDefenseDawnLocked = false;
    BroadcastRest(2);
    return true;
}

[[Event]]
void HandleCritterAttack(Critter cr, Critter attacker)
{
    // До обычной реакции Main: растерянный NPC вправе ответить только напавшему.
    DenWander::OnAttacked(cr, attacker);
    if (IsActor(cr) && cr.DenDefenseRole == ROLE_SMITTY && cr.IsAlive() && CanAct(cr) && cr.MapId == attacker.MapId &&
        (IsParticipant(attacker) || IsCompanion(attacker))) {
        EnemyStack::AddEnemyToStack(cr, attacker.Id);
    }
}

[[Event]]
void HandleCritterDeath(Critter cr, Critter? killer)
{
    bool keyDefender = IsPrimary(cr);
    if (keyDefender) {
        FailAttempt(); // Провал фиксируем до переноса вещей; тело остаётся видимым.
    }
    if (IsActor(cr) && cr.DenDefenseRole == ROLE_SMITTY) {
        cr.StopMoving();
        NpcPlanes::DropPlanes(cr);
        CancelRestWithoutSmitty();
    }
    if (IsParticipant(cr)) {
        SpillLoot(cr);
    }
    if (IsActor(cr) && cr.DenDefenseRole == ROLE_ENEMY) {
        ConfirmEnemyDeath(cr);
    }
}

void ConfirmEnemyDeath(Critter cr)
{
    if (!IsActor(cr) || cr.DenDefenseRole != ROLE_ENEMY || !cr.IsDead()) {
        return;
    }
    if (cr.MapId != Game.DenDefenseMapId) {
        Game.Log("Den defense enemy died outside its map, id=" + cr.Id);
        FailAttempt();
        return;
    }
    auto enemies = Game.DenDefenseEnemyIds.clone();
    int index = enemies.find(cr.Id);
    if (index >= 0) {
        enemies.removeAt(index);
        Game.DenDefenseEnemyIds = enemies;
        ShareKillExperience(cr);
    }
}

// Пул за смерть врага выдаём один раз, независимо от добившего, включая Смитти и среду.
void ShareKillExperience(Critter enemy)
{
    auto ids = Game.DenDefenseParticipantIds.clone();
    ids.insertLast(Game.DenDefenseCompanionIds);
    Critter[] recipients = {};
    for (int i = 0; i < ids.length(); i++) {
        Critter? cr = Game.GetCritter(ids[i]);
        if (cr != null && (IsParticipant(cr) || IsCompanion(cr)) && !cr.IsDead() && cr.MapId == enemy.MapId) {
            recipients.insertLast(cr);
        }
    }
    if (recipients.isEmpty() || enemy.KillExperience <= 0) {
        return;
    }

    int share = enemy.KillExperience / recipients.length();
    int remainder = enemy.KillExperience % recipients.length();
    // Остаток не теряем и не отдаём постоянно первому участнику или хозяину.
    int first = Game.Random(0, recipients.length() - 1);
    for (int i = 0; i < recipients.length(); i++) {
        int amount = share + (i < remainder ? 1 : 0);
        if (amount > 0) {
            recipients[(first + i) % recipients.length()].Experience += amount;
        }
    }
}

#endif

#if CLIENT

[[ModuleInit]]
void InitDenDefenseClient()
{
    Game.OnRenderIface.Subscribe(DrawRest, EventPriority::Lowest);
    Game.OnDisconnected.Subscribe(ClearFailurePresentation);
}

[[ClientRemoteCall]]
void DenDefenseTransition(int generation, int state)
{
    if (generation < Game.DenDefenseClientGeneration) {
        return;
    }
    Game.DenDefenseClientGeneration = generation;
    Game.DenDefenseClientFrozen = state != 0;
    Game.DenDefenseClientShowFailure = false;
    Game.DenDefenseClientResting = false;
    ChosenActions::SetChosenActions({});
}

[[ClientRemoteCall]]
void DenDefenseRestTransition(int generation, int phase, timespan remaining)
{
    if (generation < Game.DenDefenseClientGeneration) {
        return;
    }
    Game.DenDefenseClientGeneration = generation;
    Game.DenDefenseClientResting = phase != 2;
    Game.DenDefenseClientRestPhase = phase;
    Game.DenDefenseClientBlackAt = Game.FrameTime + remaining;
    ChosenActions::SetChosenActions({});
}

[[Event]]
void ClearFailurePresentation()
{
    Game.DenDefenseClientResting = false;
    Game.DenDefenseClientFrozen = false;
    Game.DenDefenseClientShowFailure = false;
    Game.DenDefenseClientGeneration = 0;
}

[[Event]]
void DrawRest()
{
    if (Game.DenDefenseClientResting) {
        int remaining = Game.DenDefenseClientBlackAt > Game.FrameTime ? (Game.DenDefenseClientBlackAt - Game.FrameTime).milliseconds : 0;
        int progress = Math::Clamp(remaining * 255 / 1000, 0, 255);
        int alpha = Game.DenDefenseClientRestPhase == 0 ? 255 - progress : progress;
        Effects::DrawFullscreenOverlay(ucolor(0, 0, 0, alpha));
    }
}

#endif

}
