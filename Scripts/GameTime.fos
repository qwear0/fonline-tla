// GameTime — календарь TLA, длительности и абсолютные таймауты действий.
// COMMON: все даты используют масштабированный календарь MapTime, а не эпоху движка.
// SERVER: глобальный переход вперёд; уже заведённые кадровые события сохраняют свои задержки.
// Относительные кадровые таймеры при переходе не пересчитываются.
namespace GameTime
{

void UnpackCalendar(synctime time, int& year, int& month, int& day, int& hour, int& minute, int& second, int& millisecond)
{
    int microsecond = 0;
    int nanosecond = 0;
    Game.UnpackTime(MapTime::CalendarTime(time), year, month, day, hour, minute, second, millisecond, microsecond, nanosecond);
}

int GetHour()
{
    int year = 0, month = 0, day = 0, hour = 0, minute = 0, second = 0, millisecond = 0;
    UnpackCalendar(Game.SynchronizedTime, year, month, day, hour, minute, second, millisecond);
    return hour;
}
int GetMinute()
{
    int year = 0, month = 0, day = 0, hour = 0, minute = 0, second = 0, millisecond = 0;
    UnpackCalendar(Game.SynchronizedTime, year, month, day, hour, minute, second, millisecond);
    return minute;
}
int GetMonth()
{
    int year = 0, month = 0, day = 0, hour = 0, minute = 0, second = 0, millisecond = 0;
    UnpackCalendar(Game.SynchronizedTime, year, month, day, hour, minute, second, millisecond);
    return month;
}
int GetDay()
{
    int year = 0, month = 0, day = 0, hour = 0, minute = 0, second = 0, millisecond = 0;
    UnpackCalendar(Game.SynchronizedTime, year, month, day, hour, minute, second, millisecond);
    return day;
}
int GetSecond()
{
    int year = 0, month = 0, day = 0, hour = 0, minute = 0, second = 0, millisecond = 0;
    UnpackCalendar(Game.SynchronizedTime, year, month, day, hour, minute, second, millisecond);
    return second;
}
int GetYear()
{
    int year = 0, month = 0, day = 0, hour = 0, minute = 0, second = 0, millisecond = 0;
    UnpackCalendar(Game.SynchronizedTime, year, month, day, hour, minute, second, millisecond);
    return year;
}

string SynchronizedTimeToString(synctime time)
{
    int year = 0, month = 0, day = 0, hour = 0, minute = 0, second = 0, millisecond = 0;
    UnpackCalendar(time, year, month, day, hour, minute, second, millisecond);
    return "" + (day > 9 ? "" + day : "0" + day) + "." + (month > 9 ? "" + month : "0" + month) + "." + year + " " + (hour > 9 ? "" + hour : "0" + hour) + ":" +
           (minute > 9 ? "" + minute : "0" + minute);
}

synctime FirstAidTimeout(Critter cr)
{
    return Game.SynchronizedTime + Time::Seconds(100 / ((cr.SkillFirstAid > 3 ? cr.SkillFirstAid : 3) * 100 / Tla::MaxSkillValue()));
}
synctime DoctorTimeout(Critter cr)
{
    return Game.SynchronizedTime + Time::Seconds(100 / ((cr.SkillDoctor > 3 ? cr.SkillDoctor : 3) * 100 / Tla::MaxSkillValue()) * 3);
}
synctime RepairTimeout(Critter cr)
{
    return Game.SynchronizedTime + Time::Minutes(1);
}
synctime ScienceTimeout(Critter cr)
{
    return Game.SynchronizedTime + Time::Minutes(1);
}
synctime LockpickTimeout(Critter cr)
{
    return Game.SynchronizedTime + Time::Minutes(2);
}
synctime StealTimeout(Critter cr)
{
    return Game.SynchronizedTime + Time::Minutes(2);
}
synctime TransferTimeout(Critter cr)
{
    return Game.SynchronizedTime + Time::Seconds(Settings.Movement.TimeoutTransfer);
}
synctime BattleTimeout(Critter cr)
{
    return Game.SynchronizedTime + Time::Seconds(Math::Max(Settings.Combat.TimeoutBattle - cr.ArmorClass, 12));
}
synctime TrapsTimeout(Critter cr)
{
    return Game.SynchronizedTime + Time::Minutes(1);
}
synctime TrapsTimeoutAlt(Critter cr)
{
    return Game.SynchronizedTime + Time::Minutes(2);
}
synctime SneakTimeout(Critter cr)
{
    return Game.SynchronizedTime + Time::Seconds(Math::Max(34 - cr.Sequence, 3));
}
synctime HealingTimeout(Critter cr)
{
    return Game.SynchronizedTime + Time::Minutes(2);
}

const timespan MAXIMUM_TIMEOUT = Time::Hours(5);

bool IsMorning(int hour)
{
    return hour >= 7 && hour <= 11;
}
bool IsAfternoon(int hour)
{
    return hour >= 12 && hour <= 21;
}
bool IsNight(int hour)
{
    return hour >= 22 || hour <= 6;
}
bool IsTurnBasedTimeout(Critter cr)
{
    return cr.TimeoutBattle > Game.SynchronizedTime && cr.TimeoutBattle - Game.SynchronizedTime > Time::Seconds(10);
}

timespan GameSeconds(int value)
{
    return timespan(int64(value) * 1000 / Settings.WorldTime.Multiplier, Time::MillisecondsPlace);
}

// Нулевые компоненты даты задают повторение; 24:00 — полночь следующих суток.
synctime GetNearSynchronizedTime(int year, int month, int day, int hour, int minute, int second)
{
    return GetNearSynchronizedTimeFrom(Game.SynchronizedTime, year, month, day, hour, minute, second);
}

synctime GetNearSynchronizedTimeFrom(synctime from, int year, int month, int day, int hour, int minute, int second)
{
    int y = 0, m = 0, d = 0, h = 0, mi = 0, s = 0, ms = 0;
    UnpackCalendar(from, y, m, d, h, mi, s, ms);
    int jump = 0;
    if (year == 0) {
        year = y;
        jump = 1;
    }
    if (month == 0) {
        month = m;
        jump = 2;
    }
    if (day == 0) {
        day = d;
        jump = 3;
    }
    // 24:00 — конец выбранной даты, а не начало той же даты; перенос месяца/года делает календарь.
    bool nextMidnight = hour == 24;
    if (nextMidnight) {
        hour = 0;
    }
    while (true) {
        if (day <= GetDaysInMonth(year, month)) {
            nanotime calendar = Game.PackTime(year, month, day, hour, minute, second, 0, 0, 0);
            if (nextMidnight) {
                calendar += Time::Days(1);
            }
            synctime target = MapTime::SynchronizedTime(calendar);
            if (target > from) {
                return target;
            }
            if (jump == 0) {
                return from + Time::Milliseconds(1);
            }
        }
        if (jump == 1) {
            year++;
        }
        else if (jump == 2) {
            month++;
            if (month > 12) {
                month = 1;
                year++;
            }
        }
        else if (jump == 3) {
            day++;
            if (day > GetDaysInMonth(year, month)) {
                day = 1;
                month++;
                if (month > 12) {
                    month = 1;
                    year++;
                }
            }
        }
        else {
            throw("Invalid fixed calendar date", year, month, day);
        }
    }
    return from;
}

int GetDaysInMonth(int year, int month)
{
    switch (month) {
    case 1:
    case 3:
    case 5:
    case 7:
    case 8:
    case 10:
    case 12:
        return 31;
    case 2:
        return year % 400 == 0 || (year % 4 == 0 && year % 100 != 0) ? 29 : 28;
    default:
        return 30;
    }
}

#if SERVER

void AdvanceCalendarTo(synctime target)
{
    if (target <= Game.SynchronizedTime) {
        return;
    }
    Game.SetSynchronizedTime(target);
    MapTime::UpdateDateTimeImpl();
}

#endif

}
