// DenCleanup — Тодд у грузовика убирает тела врагов после завершённых волн осады Сьерры.
// SERVER: подход к телу, перенос к задней части грузовика, секунда разгрузки и уборка перед волной.
// CLIENT: постоянный локализованный счётчик над грузовиком, независимо от имён и реплик NPC.
// Счётчик и несомое тело сохраняются на карте; задание на NPC, изменяемых глобальных таблиц нет.
// Связи: DenDefense (стадии и поколения), MercLoot (резерв тела), NpcPlanes, ItemStacks.
namespace DenCleanup
{

///@ Property Map Common int64 DenCleanupCorpseCount Mutable PublicSync Persistent

#if SERVER

///@ Property Map Server bool DenCleanupCarrying Mutable Persistent
///@ Property Critter Server mpos DenCleanupReturnHex Mutable
///@ Property Critter Server ident DenCleanupTargetId Mutable
///@ Property Critter Server nanotime DenCleanupReadyAt Mutable
///@ Property Critter Server nanotime DenCleanupStartAt Mutable
///@ Property Critter Server nanotime DenCleanupTargetUntil Mutable
///@ Property Critter Server int32 DenCleanupGeneration Mutable
///@ Property Critter Server int32 DenCleanupWave Mutable
///@ Property Critter Server ident[] DenCleanupSkippedIds Mutable

Item GetSupplies(Map map)
{
    const mpos hex = mpos(35, 60);
    Item[] crates = map.GetItemsInRadius(hex, 0, "DenDefenseSupplies".hstr());
    verify(crates.length() <= 1, "More than one Smitty supplies crate");
    // Сохранённая карта могла быть создана до добавления авторского ящика.
    return crates.isEmpty() ? ItemStacks::AddItem(map, hex, "DenDefenseSupplies".hstr(), 1) : crates[0];
}

void StoreItems(Item[] items, Map map)
{
    Item crate = GetSupplies(map);
    for (int i = 0; i < items.length(); i++) {
        Item item = items[i];
        if (!item.Hidden && !item.IsGag) {
            Item? stored = ItemStacks::MoveItem(item, item.Count, crate, Tla::RootContainerStack());
            verify(stored != null && stored.Ownership == ItemOwnership::ItemContainer && stored.ContainerId == crate.Id, "Unable to store Den supplies", item);
        }
    }
}

// Переносим вещи из мастерской и двора, но не декорации, двери и чужие контейнеры.
void StoreGroundSupplies(Map map)
{
    Item[] items = map.GetItemsInRadius(mpos(40, 60), 12);
    Item[] supplies = {};
    for (int i = 0; i < items.length(); i++) {
        Item item = items[i];
        if (item.IsCanPickUp && !item.Hidden && !item.IsGag && item.Type != ItemType::Container) {
            supplies.insertLast(item);
        }
    }
    StoreItems(supplies, map);
}

void Init(Critter todd, bool firstTime)
{
    todd.DialogId = "den_defense_todd".hstr();
    todd.BagId = Bags::Empty;
    todd.StopTimeEvent(NpcBags::OnCritterIdle);
    todd.IsNoHome = true;
    todd.IsNoEnemyStack = true;
    todd.ReplicationTime = -1;
    todd.StopMoving();
    NpcPlanes::DropPlanes(todd);
    EnemyStack::ClearEnemyStack(todd);
    todd.StopTimeEvent(Idle);
    todd.StartTimeEvent(Time::Milliseconds(250), Time::Milliseconds(250), Idle);
}

void Setup(Map map)
{
    Critter? todd = GetTodd(map);
    // Старые сохранённые карты не получают новых авторских NPC автоматически.
    if (todd == null) {
        dict<CritterProperty, any> props = {{CritterProperty::BagId, int(Bags::Empty)},
                                            {CritterProperty::DialogId, "den_defense_todd".hstr()},
                                            {CritterProperty::AiId, 14},
                                            {CritterProperty::TeamId, 4}};
        todd = map.AddCritter(Content::Critter::Loser, mpos(50, 56), HDIR_Random, props);
    }
    verify(todd != null, "Sierra Todd is missing");
    Init(todd, false);
    DeliverCarried(map);
    ResetAtTruck(todd, map);
    MercStorage::Setup(map);
    StoreGroundSupplies(map);
}

Critter? GetTodd(Map map)
{
    Critter? todd = null;
    Critter[] inhabitants = map.GetCritters(CritterFindType::Npc);
    for (int i = 0; i < inhabitants.length(); i++) {
        Critter cr = inhabitants[i];
        if (cr.DialogId == "den_defense_todd".hstr() && !cr.ControlledByPlayer && cr.MercMasterId == ZERO_IDENT) {
            verify(todd == null, "More than one Todd on Sierra entrance");
            todd = cr;
        }
    }
    return todd;
}

// Исходный гекс — сзади грузовика. Телепорт выбирает равновероятно из всего доступного радиуса.
bool FindTruckHex(Critter todd, Map map, bool teleport, mpos& hex)
{
    const mpos center = mpos(50, 56);
    const mpos workshop = mpos(37, 60);
    mpos[] candidates = {};
    for (int x = int(center.x) - 3; x <= int(center.x) + 3; x++) {
        for (int y = int(center.y) - 3; y <= int(center.y) + 3; y++) {
            if (x < 0 || y < 0 || x >= int(map.Size.width) || y >= int(map.Size.height)) {
                continue;
            }
            mpos candidate = mpos(x, y);
            Critter? occupant = map.GetCritterOnHex(candidate);
            if (Game.GetDistance(center, candidate) > 3 || (occupant != null && occupant.Id != todd.Id) ||
                (!map.IsHexMovable(candidate) && todd.Hex != candidate) || map.GetPathLength(candidate, workshop, 1, DenDefense::CanLeaveSpawnHouse) == 0 ||
                (!teleport && todd.Hex != candidate && map.GetPathLength(todd, candidate, 0, MainPlanes::CanOpenDoor) == 0)) {
                continue;
            }
            if (!teleport && candidate == center) {
                hex = candidate;
                return true;
            }
            candidates.insertLast(candidate);
        }
    }
    if (candidates.isEmpty()) {
        return false;
    }
    hex = candidates[Game.Random(0, candidates.length() - 1)];
    return true;
}

void ReleaseTarget(Critter todd)
{
    MercLoot::RemoveWalk(todd, "DenCleanup".hstr());
    todd.StopMoving();
    todd.DenCleanupTargetId = ZERO_IDENT;
    todd.DenCleanupTargetUntil = ZERO_NANOTIME;
    todd.DenCleanupReadyAt = ZERO_NANOTIME;
}

void ResetAtTruck(Critter todd, Map map)
{
    mpos hex;
    verify(FindTruckHex(todd, map, true, hex), "Todd truck-side home is blocked");
    ReleaseTarget(todd);
    todd.TransferToMap(map, hex, HDIR_Random, true);
    verify(todd.MapId == map.Id && todd.Hex == hex, "Unable to reset Todd at truck");
    todd.HomeMapId = map.Id;
    todd.HomeHex = mpos(50, 56);
    todd.DenCleanupSkippedIds = {};
}

// Несомое тело уже удалено с карты: оно не попадает в повторный обход трупов.
// Флаг сохраняется отдельно от временного NPC-задания, в том числе при рестарте/сбросе попытки.
void DeliverCarried(Map map)
{
    if (map.DenCleanupCarrying) {
        map.DenCleanupCorpseCount = map.DenCleanupCorpseCount + 1;
        map.DenCleanupCarrying = false;
    }
}

bool IsCleanupCorpse(Critter corpse, Map map)
{
    return corpse.MapId == map.Id && !corpse.ControlledByPlayer && corpse.MercMasterId == ZERO_IDENT && MercLoot::IsWaveCorpse(corpse) &&
           Game.DenDefenseEnemyHistory.exists(corpse.Id);
}

bool CanClean(Critter todd, Critter corpse, Map map)
{
    return IsCleanupCorpse(corpse, map) && !MercLoot::IsReserved(todd, map, corpse.Id);
}

void RemoveCorpse(Critter corpse)
{
    verify(DenDefense::SpillLoot(corpse), "Unable to spill Den corpse inventory", corpse);
    Game.DestroyCritter(corpse);
}

// Только подтверждённый запуск следующей волны, не запрос отдыха и не новая попытка.
// Убираем также недоступные/зарезервированные тела, но не игроков, спутников и чужих NPC.
void BeforeWave(Map map)
{
    verify(map.Id == Game.DenDefenseMapId, "Wrong Sierra cleanup map");
    Critter? todd = GetTodd(map);
    verify(todd != null, "Sierra Todd is missing before wave");
    ResetAtTruck(todd, map);
    DeliverCarried(map);
    Critter[] collectors = map.GetCritters(CritterFindType::NonDeadNpc);
    Critter[] corpses = map.GetCritters(CritterFindType::DeadNpc);
    for (int i = 0; i < corpses.length(); i++) {
        Critter corpse = corpses[i];
        if (!IsCleanupCorpse(corpse, map)) {
            continue;
        }
        for (int j = 0; j < collectors.length(); j++) {
            Critter collector = collectors[j];
            if (collector.MercLootActive && collector.MercLootCorpse && collector.MercLootTargetId == corpse.Id) {
                MercLoot::ReleaseTarget(collector);
            }
        }
        RemoveCorpse(corpse);
        // Фиксируем каждый успешно удалённый труп сразу: повтор не пересчитает уже удалённые.
        map.DenCleanupCorpseCount = map.DenCleanupCorpseCount + 1;
    }
}

void ReturnToTruck(Critter todd, Map map)
{
    mpos hex = todd.DenCleanupReturnHex;
    Critter? occupant = map.GetCritterOnHex(hex);
    if (todd.DenCleanupTargetUntil == ZERO_NANOTIME || Game.FrameTime >= todd.DenCleanupTargetUntil || (occupant != null && occupant.Id != todd.Id)) {
        ReleaseTarget(todd);
        if (!FindTruckHex(todd, map, false, hex)) {
            return; // Несомое тело не теряется; ждём, пока освободится подход к грузовику.
        }
        todd.DenCleanupReturnHex = hex;
        todd.DenCleanupTargetUntil = Game.FrameTime + Time::Seconds(30);
    }
    if (todd.Hex != hex) {
        todd.DenCleanupReadyAt = ZERO_NANOTIME;
        if (NpcPlanes::GetPlanes(todd, "DenCleanup".hstr()) == null) {
            NpcPlanes::AddWalkPlane(todd, NpcPlanes::AI_PLANE_PICK_PRIORITY, "DenCleanup".hstr(), 0, hex, Game.GetDirection(todd.Hex, hex), false, 0);
        }
        return;
    }
    MercLoot::RemoveWalk(todd, "DenCleanup".hstr());
    todd.StopMoving();
    if (todd.DenCleanupReadyAt == ZERO_NANOTIME) {
        // У nmlosr нет кадров PickUp/Use: не скрываем NPC отсутствующей анимацией.
        todd.SetDir(Game.GetDirection(todd.Hex, mpos(51, 51)));
        todd.DenCleanupReadyAt = Game.FrameTime + Time::Seconds(1);
        return;
    }
    if (Game.FrameTime >= todd.DenCleanupReadyAt) {
        DeliverCarried(map);
        ReleaseTarget(todd);
    }
}

bool SelectTarget(Critter todd, Map map)
{
    int bestDistance = 2147483647;
    Critter? best = null;
    Critter[] corpses = map.GetCritters(CritterFindType::DeadNpc);
    for (int i = 0; i < corpses.length(); i++) {
        Critter corpse = corpses[i];
        if (!CanClean(todd, corpse, map) || todd.DenCleanupSkippedIds.exists(corpse.Id)) {
            continue;
        }
        int distance = Game.GetDistance(todd.Hex, corpse.Hex);
        int cut = 1 + todd.Multihex + corpse.Multihex;
        if (distance < bestDistance && (distance <= cut || map.GetPathLength(todd, corpse.Hex, cut, MainPlanes::CanOpenDoor) > 0)) {
            best = corpse;
            bestDistance = distance;
        }
    }
    if (best == null) {
        return false;
    }
    todd.DenCleanupTargetId = best.Id;
    todd.DenCleanupTargetUntil = Game.FrameTime + Time::Seconds(30);
    return true;
}

[[TimeEvent]]
void Idle(Critter todd)
{
    Map? map = todd.GetMap();
    bool finished = Game.DenDefenseStage == DenDefense::STAGE_WAITING || Game.DenDefenseStage == DenDefense::STAGE_VICTORY;
    if (!todd.IsAlive() || map == null || map.Id != Game.DenDefenseMapId || !finished || Game.DenDefenseWave == 0 ||
        Game.DenDefenseSpawned != Game.DenDefenseSpawnTotal || !Game.DenDefenseEnemyIds.isEmpty()) {
        ReleaseTarget(todd);
        return;
    }
    if (todd.DenCleanupGeneration != Game.DenDefenseGeneration || todd.DenCleanupWave != Game.DenDefenseWave) {
        ReleaseTarget(todd);
        todd.DenCleanupGeneration = Game.DenDefenseGeneration;
        todd.DenCleanupWave = Game.DenDefenseWave;
        todd.DenCleanupSkippedIds = {};
        todd.DenCleanupStartAt = Game.FrameTime + Time::Seconds(Game.Random(7, 15));
    }
    if (Game.FrameTime < todd.DenCleanupStartAt) {
        return;
    }
    if (todd.DenCleanupTargetId != ZERO_IDENT && Game.FrameTime >= todd.DenCleanupTargetUntil) {
        auto skipped = todd.DenCleanupSkippedIds.clone();
        skipped.insertLast(todd.DenCleanupTargetId);
        todd.DenCleanupSkippedIds = skipped;
        ReleaseTarget(todd);
    }
    if (CritterState::IsBusy(todd) || Dialogs::IsTalking(todd)) {
        return;
    }
    if (map.DenCleanupCarrying) {
        ReturnToTruck(todd, map);
        return;
    }
    if (todd.DenCleanupTargetId == ZERO_IDENT && !SelectTarget(todd, map)) {
        return;
    }
    Critter? corpse = Game.GetCritter(todd.DenCleanupTargetId);
    if (corpse == null || !CanClean(todd, corpse, map)) {
        ReleaseTarget(todd);
        return;
    }
    int cut = 1 + todd.Multihex + corpse.Multihex;
    if (Game.GetDistance(todd.Hex, corpse.Hex) > cut) {
        todd.DenCleanupReadyAt = ZERO_NANOTIME;
        if (NpcPlanes::GetPlanes(todd, "DenCleanup".hstr()) == null) {
            NpcPlanes::AddWalkPlane(todd,
                                    NpcPlanes::AI_PLANE_PICK_PRIORITY,
                                    "DenCleanup".hstr(),
                                    0,
                                    corpse.Hex,
                                    Game.GetDirection(todd.Hex, corpse.Hex),
                                    false,
                                    cut);
        }
        return;
    }
    MercLoot::RemoveWalk(todd, "DenCleanup".hstr());
    todd.StopMoving();
    todd.SetDir(Game.GetDirection(todd.Hex, corpse.Hex));
    RemoveCorpse(corpse);
    map.DenCleanupCarrying = true;
    ReleaseTarget(todd);
    if (Game.Random(1, 100) <= 33) {
        // DialogBaker сохраняет авторский ключ буквально, без прежнего числового смещения.
        Messaging::Say(todd, TextPackKey(TextPackName::Dialogs, todd.DialogId, "" + Game.Random(100, 109)));
    }
    ReturnToTruck(todd, map);
}

#endif

#if CLIENT

[[ModuleInit]]
void InitClient()
{
    Game.OnPreRenderIface.Subscribe(DrawTruckCounter);
}

[[Event]]
void DrawTruckCounter()
{
    if (!HasCurMap || CurMap.ProtoId != Content::Map::sad_enter) {
        return;
    }
    const mpos truck = mpos(51, 51);
    ipos pos = CurMap.GetHexScreenPos(truck);
    isize content = CurMap.GetHexContentSize(truck);
    string text = Game.FormatTags(Game.GetText(TextPackKey(TextPackName::Text, "DenCleanup", "TruckCorpses")),
                                  TextFormatting::TextArg("count", "" + CurMap.DenCleanupCorpseCount));
    Game.DrawText(text,
                  pos + ipos(-200, -content.height),
                  isize(400, 0),
                  Color::White,
                  TextFormat(FontType::Default, FontFlag(int(FontFlag::CenterX) | int(FontFlag::AlignBottom) | int(FontFlag::Bordered)), 0));
}

#endif

}
