// DenWander — растерянность, залипание, камни, парные драки и бег врагов первой волны.
// SERVER: один бросок поведения до выбора прототипа; DenDefense вызывает Process до выбора жертвы.
// Режим, цели, напарник и реальные сроки хранятся на NPC; общих изменяемых таблиц нет.
// Бегуны кружат вокруг допустимого противника и отскакивают после сближения.
// Связи: DenDefense (допуск атак и урона), MainPlanes (оружие), NpcPlanes, Messaging.
namespace DenWander
{

#if SERVER

///@ Property Critter Server bool DenWanderActive Mutable
///@ Property Critter Server mpos DenWanderGoal Mutable
///@ Property Critter Server ident[] DenWanderAttackerIds Mutable
///@ Property Critter Server nanotime DenWanderRecheckAt Mutable
///@ Property Critter Server int32 DenWanderMode Mutable
///@ Property Critter Server mpos DenWanderFocus Mutable
///@ Property Critter Server nanotime DenWanderUntil Mutable
///@ Property Critter Server nanotime DenWanderSayAt Mutable
///@ Property Critter Server ident DenWanderPartnerId Mutable
///@ Property Critter Server bool DenWanderReady Mutable
///@ Property Critter Server bool DenWanderFleeing Mutable
///@ Property Critter Server ident DenWanderTargetId Mutable
///@ Property Critter Server int32 DenWanderRunPhase Mutable
///@ Property Critter Server int32 DenWanderRunTurn Mutable

const int LOST = 1;
const int STARE = 2;
const int ROCKS = 3;
const int BRAWL = 4;
const int RUN = 5;
const int RUN_CIRCLE = 0;
const int RUN_APPROACH = 1;
const int RUN_RETREAT = 2;

[[ModuleInit]]
void Init()
{
    Game.OnCritterMoved.Subscribe(RunnerMoved);
}

bool IsYardHex(mpos hex)
{
    // Центральное поле между домом и левым бункером, от входного ограждения
    // до фасада базы. Боковые площадки, дом, бункер и внутренность базы не входят.
    return hex.x >= 49 && hex.x <= 99 && hex.y >= 33 && hex.y <= 128;
}

bool CanStand(Critter npc, Map map, mpos hex)
{
    return IsYardHex(hex) && map.IsHexesMovable(hex, npc.Multihex) && (map.GetCritterOnHex(hex) == null || npc.Hex == hex) &&
           (npc.Hex == hex || map.GetPathLength(npc, hex, 0, MainPlanes::CanOpenDoor) > 0);
}

bool PickGoal(Critter npc, Map map, Critter? avoid = null)
{
    mpos[] candidates = {};
    int escapeDistance = avoid != null ? Math::Min(20, Game.GetDistance(npc, avoid) + 5) : 0;
    for (int x = 49; x <= 99; x++) {
        for (int y = 33; y <= 128; y++) {
            mpos hex = mpos(x, y);
            if (hex != npc.Hex && map.IsHexesMovable(hex, npc.Multihex) && map.GetCritterOnHex(hex) == null &&
                (avoid == null || Game.GetDistance(hex, avoid.Hex) >= escapeDistance)) {
                candidates.insertLast(hex);
            }
        }
    }
    // Равновероятный выбор без повторов; путь ищем только до первого пригодного гекса.
    while (!candidates.isEmpty()) {
        int index = Game.Random(0, candidates.length() - 1);
        mpos hex = candidates[index];
        candidates[index] = candidates[candidates.length() - 1];
        candidates.removeLast();
        if (map.GetPathLength(npc, hex, 0, MainPlanes::CanOpenDoor) > 0) {
            npc.DenWanderGoal = hex;
            return true;
        }
    }
    npc.DenWanderGoal = mpos();
    return false;
}

void Stop(Critter npc)
{
    npc.StopMoving();
    NpcPlanes::DropPlanes(npc);
}

void Finish(Critter npc, bool stop = true)
{
    if (stop) {
        Stop(npc);
    }
    npc.DenWanderActive = false;
    npc.DenWanderMode = 0;
    npc.DenWanderGoal = mpos();
    npc.DenWanderAttackerIds = {};
    npc.DenWanderPartnerId = ZERO_IDENT;
    npc.DenWanderReady = false;
    npc.DenWanderFleeing = false;
    npc.DenWanderUntil = ZERO_NANOTIME;
    npc.DenWanderSayAt = ZERO_NANOTIME;
    npc.DenWanderRecheckAt = ZERO_NANOTIME;
    npc.DenWanderTargetId = ZERO_IDENT;
    npc.DenWanderRunPhase = RUN_CIRCLE;
    npc.DenWanderRunTurn = 0;
}

bool CanRun(Critter npc)
{
    auto type = CritterTypes::GetCritterType(npc);
    return type != null && type.CanRun && !npc.IsNoRun;
}

bool CanThrow(Critter npc)
{
    // Метатели получают nmbsnp с NMBSNPAS (бросок); у nmlosr этой анимации нет.
    // Сервер не загружает клиентский пакет спрайтов, поэтому модель проверяем явно.
    return npc.ModelName == "art/critters/nmbsnpaa.frm".hstr();
}

int RollMode()
{
    if (Game.DenDefenseWave != 1) {
        return 0;
    }
    int roll = Game.Random(1, 100);
    if (roll <= 30) {
        return LOST;
    }
    if (roll <= 40) {
        return STARE;
    }
    if (roll <= 60) {
        return ROCKS;
    }
    if (roll <= 70) {
        return BRAWL;
    }
    if (roll <= 80) {
        return RUN;
    }
    return 0;
}

void TryStart(Critter npc, int mode)
{
    if (Game.DenDefenseWave != 1) {
        return;
    }
    verify(mode != RUN || CanRun(npc), "Siege runner animation missing", npc);
    verify(mode != ROCKS || CanThrow(npc), "Siege rock throw animation missing", npc);
    npc.DenWanderMode = mode;
    npc.DenWanderActive = mode != 0;
    npc.OnNpcPlaneEnd.Subscribe(WalkEnd);
    if (mode == ROCKS) {
        Map? map = npc.GetMap();
        verify(map != null, "Rock thrower spawned without map", npc);
        // Один стартовый камень в руках; дальше только конечный запас на земле.
        // Брошенные камни Combat оставляет у цели, откуда их можно подобрать снова.
        Item rock = ItemStacks::AddItem(npc, Content::Item::rock, 1);
        npc.ChangeItemSlot(rock.Id, CritterItemSlot::Main);
        if (PickGoal(npc, map)) {
            ItemStacks::AddItem(map, npc.DenWanderGoal, Content::Item::rock, Game.Random(3, 6));
            npc.DenWanderGoal = mpos();
        }
    }
}

bool IsPair(Critter first, Critter second)
{
    return first.Id != second.Id && first.DenWanderActive && second.DenWanderActive && first.DenWanderMode == BRAWL && second.DenWanderMode == BRAWL &&
           first.DenWanderPartnerId == second.Id && second.DenWanderPartnerId == first.Id && DenDefense::IsWaveEnemy(first) &&
           DenDefense::IsWaveEnemy(second) && first.MapId == second.MapId;
}

bool CanAttack(Critter npc, Critter target)
{
    if (!npc.DenWanderActive) {
        return true;
    }
    if (npc.DenWanderMode == BRAWL) {
        return IsPair(npc, target) && npc.DenWanderReady && target.DenWanderReady && !npc.DenWanderFleeing && npc.CurrentHp * 100 >= npc.MaxLife * 10;
    }
    if (npc.DenWanderMode == ROCKS) {
        return Game.GetDistance(npc, target) <= 1 + npc.Multihex + target.Multihex || npc.GetItem(Content::Item::rock) != null;
    }
    return npc.DenWanderMode == LOST && npc.DenWanderAttackerIds.exists(target.Id);
}

void OnAttacked(Critter npc, Critter attacker)
{
    if (!npc.DenWanderActive || npc.DenWanderMode != LOST || !DenDefense::IsWaveEnemy(npc) || !npc.IsAlive() || !DenDefense::CanAct(npc) ||
        npc.MapId != attacker.MapId ||
        (!DenDefense::IsParticipant(attacker) && (!DenDefense::IsActor(attacker) || attacker.DenDefenseRole == DenDefense::ROLE_ENEMY))) {
        return;
    }
    auto ids = npc.DenWanderAttackerIds.clone();
    if (!ids.exists(attacker.Id)) {
        ids.insertLast(attacker.Id);
        npc.DenWanderAttackerIds = ids;
    }
}

void Arrive(Critter npc, bool stop = true)
{
    Finish(npc, stop);
    Messaging::Say(npc, TextPackKey(TextPackName::Text, "DenWander", "Arrival" + Game.Random(1, 9)));
}

// Говорим при завершении именно своего маршрута, не при остановке на соседнем гексе.
[[Event]]
void WalkEnd(Critter npc, int planeId, int reason, Critter? someCr, Item? someItem)
{
    NpcPlanes::NpcPlane? plane = NpcPlanes::GetCritterPlane(npc, planeId);
    if (npc.DenWanderActive && npc.DenWanderMode == LOST && DenDefense::IsWaveEnemy(npc) && npc.IsAlive() && DenDefense::CanAct(npc) &&
        Game.DenDefenseStage == DenDefense::STAGE_FIGHTING && plane != null && plane.Identifier == "DenWander".hstr() && reason == NpcPlanes::REASON_SUCCESS &&
        npc.Hex == npc.DenWanderGoal) {
        // Завершаемый план удалит NpcPlanes: внутри его callback таблицу не очищаем.
        Arrive(npc, false);
    }
}

void Walk(Critter npc, bool run = false)
{
    if (!IsYardHex(npc.DenWanderGoal)) {
        return;
    }
    // Идентификатор находится и у родителя: не прерываем открытие двери на маршруте.
    if (NpcPlanes::GetPlanes(npc, "DenWander".hstr()) != null) {
        return;
    }
    Stop(npc);
    NpcPlanes::AddWalkPlane(npc, 0, "DenWander".hstr(), 0, npc.DenWanderGoal, Game.GetDirection(npc.Hex, npc.DenWanderGoal), run && CanRun(npc), 0);
}

void Attack(Critter npc, Critter target, bool run = false)
{
    auto planes = NpcPlanes::GetPlanes(npc);
    if (planes != null && planes[0].Type == NpcPlanes::AI_PLANE_ATTACK && planes[0].Attack_TargId == target.Id && planes[0].Run == (run && CanRun(npc))) {
        return;
    }
    Stop(npc);
    NpcPlanes::AddAttackPlane(npc, 0, target, run && CanRun(npc));
}

bool Retaliate(Critter npc, Map map)
{
    Critter? best = null;
    int nearest = 2147483647;
    for (int i = 0; i < npc.DenWanderAttackerIds.length(); i++) {
        Critter? attacker = Game.GetCritter(npc.DenWanderAttackerIds[i]);
        if (attacker == null || attacker.IsDead() || !DenDefense::CanAttack(npc, attacker) || !npc.IsSee(attacker)) {
            continue;
        }
        int distance = Game.GetDistance(npc, attacker);
        int cut = 1 + npc.Multihex + attacker.Multihex;
        if (distance < nearest && (distance <= cut || map.GetPathLength(npc, attacker.Hex, cut, MainPlanes::CanOpenDoor) > 0)) {
            best = attacker;
            nearest = distance;
        }
    }
    if (best != null) {
        Attack(npc, best);
        return true;
    }
    auto planes = NpcPlanes::GetPlanes(npc);
    if (planes != null && planes[0].Type == NpcPlanes::AI_PLANE_ATTACK) {
        Stop(npc);
    }
    return false;
}

bool FindNear(Critter npc, Map map, mpos center, int radius, mpos& goal)
{
    for (int ring = 1; ring <= radius; ring++) {
        mpos[] candidates = {};
        for (int x = int(center.x) - ring * 2; x <= int(center.x) + ring * 2; x++) {
            for (int y = int(center.y) - ring * 2; y <= int(center.y) + ring * 2; y++) {
                if (x < 0 || y < 0 || x >= int(map.Size.width) || y >= int(map.Size.height)) {
                    continue;
                }
                mpos hex = mpos(x, y);
                if (Game.GetDistance(center, hex) == ring && IsYardHex(hex) && map.IsHexesMovable(hex, npc.Multihex) &&
                    (map.GetCritterOnHex(hex) == null || npc.Hex == hex)) {
                    candidates.insertLast(hex);
                }
            }
        }
        while (!candidates.isEmpty()) {
            int index = Game.Random(0, candidates.length() - 1);
            mpos hex = candidates[index];
            candidates.removeAt(index);
            if (CanStand(npc, map, hex)) {
                goal = hex;
                return true;
            }
        }
    }
    return false;
}

bool PickFocus(Critter npc, Map map)
{
    mpos[] objects = {};
    // Авторские прототипы бочек, грузовиков, шин и деревьев sad_enter.
    const hstring[] props = {"generic_2005".hstr(),
                             "generic_2006".hstr(),
                             "generic_2007".hstr(),
                             "generic_2321".hstr(),
                             "generic_2323".hstr(),
                             "generic_2101".hstr(),
                             "generic_2945".hstr(),
                             "generic_2946".hstr(),
                             "generic_2947".hstr()};
    auto statics = map.GetStaticItems();
    for (int i = 0; i < statics.length(); i++) {
        if (props.exists(statics[i].ProtoId) && IsYardHex(statics[i].Hex) && !objects.exists(statics[i].Hex)) {
            objects.insertLast(statics[i].Hex);
        }
    }
    auto turrets = map.GetCritters(CritterFindType::NonDead);
    for (int i = 0; i < turrets.length(); i++) {
        if (turrets[i].ProtoId == Content::Critter::AutoCannon && IsYardHex(turrets[i].Hex)) {
            objects.insertLast(turrets[i].Hex);
        }
    }
    while (!objects.isEmpty()) {
        int index = Game.Random(0, objects.length() - 1);
        mpos focus = objects[index];
        objects.removeAt(index);
        mpos goal;
        if (FindNear(npc, map, focus, 3 + npc.Multihex, goal)) {
            npc.DenWanderFocus = focus;
            npc.DenWanderGoal = goal;
            return true;
        }
    }
    return false;
}

void SayPeriodically(Critter npc, string prefix, int count)
{
    if (Game.FrameTime >= npc.DenWanderSayAt) {
        Messaging::Say(npc, TextPackKey(TextPackName::Text, "DenWander", prefix + Game.Random(1, count)));
        npc.DenWanderSayAt = Game.FrameTime + Time::Seconds(Game.Random(30, 60));
    }
}

void ProcessStare(Critter npc, Map map)
{
    if (npc.DenWanderUntil != ZERO_NANOTIME) {
        // Даже при минутном залипании и первом интервале в 60 секунд реплика
        // предшествует окончанию: минимум одна гарантирована.
        Stop(npc);
        npc.SetDir(Game.GetDirection(npc.Hex, npc.DenWanderFocus));
        SayPeriodically(npc, "Stare", 14);
        if (Game.FrameTime >= npc.DenWanderUntil) {
            Finish(npc);
        }
        return;
    }
    if (npc.Hex == npc.DenWanderGoal && IsYardHex(npc.DenWanderGoal)) {
        Stop(npc);
        npc.SetDir(Game.GetDirection(npc.Hex, npc.DenWanderFocus));
        npc.DenWanderUntil = Game.FrameTime + Time::Seconds(Game.Random(60, 180));
        npc.DenWanderSayAt = Game.FrameTime + Time::Seconds(Game.Random(30, 60));
        return;
    }
    if (Game.FrameTime >= npc.DenWanderRecheckAt) {
        npc.DenWanderRecheckAt = Game.FrameTime + Time::Seconds(5);
        if (!CanStand(npc, map, npc.DenWanderGoal)) {
            Stop(npc);
            npc.DenWanderGoal = mpos();
            PickFocus(npc, map);
        }
    }
    Walk(npc);
}

bool PairGoals(Critter npc, Critter partner, Map map)
{
    // Пробуем несколько площадок, обе точки должны быть достижимы для своей модели.
    for (int attempt = 0; attempt < 8; attempt++) {
        mpos other;
        if (PickGoal(npc, map) && FindNear(partner, map, npc.DenWanderGoal, 1, other)) {
            Stop(npc);
            Stop(partner);
            partner.DenWanderGoal = other;
            partner.DenWanderReady = false;
            npc.DenWanderReady = false;
            partner.DenWanderRecheckAt = Game.FrameTime + Time::Seconds(5);
            npc.DenWanderRecheckAt = partner.DenWanderRecheckAt;
            return true;
        }
    }
    partner.DenWanderGoal = mpos();
    npc.DenWanderGoal = mpos();
    return false;
}

bool FindPartner(Critter npc, Map map)
{
    Critter[] candidates = {};
    auto ids = Game.DenDefenseEnemyIds.clone();
    for (int i = 0; i < ids.length(); i++) {
        Critter? other = Game.GetCritter(ids[i]);
        if (other != null && other.Id != npc.Id && other.IsAlive() && other.MapId == npc.MapId && DenDefense::IsWaveEnemy(other) &&
            other.DenWanderPartnerId == ZERO_IDENT && !other.IsNoUnarmed) {
            candidates.insertLast(other);
        }
    }
    while (!candidates.isEmpty()) {
        int index = Game.Random(0, candidates.length() - 1);
        Critter partner = candidates[index];
        candidates.removeAt(index);
        mpos previousGoal = partner.DenWanderGoal;
        if (!PairGoals(npc, partner, map)) {
            partner.DenWanderGoal = previousGoal;
            continue;
        }
        // Выбранный напарник принудительно прекращает прежнее занятие.
        partner.DenWanderActive = true;
        partner.DenWanderMode = BRAWL;
        partner.DenWanderUntil = ZERO_NANOTIME;
        partner.DenWanderSayAt = ZERO_NANOTIME;
        partner.DenWanderAttackerIds = {};
        partner.DenWanderFleeing = false;
        npc.DenWanderPartnerId = partner.Id;
        partner.DenWanderPartnerId = npc.Id;
        return true;
    }
    return false;
}

void ProcessBrawl(Critter npc, Map map)
{
    if (npc.DenWanderPartnerId == ZERO_IDENT) {
        if (Game.FrameTime >= npc.DenWanderRecheckAt) {
            npc.DenWanderRecheckAt = Game.FrameTime + Time::Seconds(5);
            // После последней партии ждать уже некого — возвращаемся к осаде.
            if (!FindPartner(npc, map) && Game.DenDefenseSpawned >= Game.DenDefenseSpawnTotal) {
                Finish(npc);
            }
        }
        return;
    }
    Critter? partner = Game.GetCritter(npc.DenWanderPartnerId);
    if (partner == null || !partner.IsAlive() || !IsPair(npc, partner)) {
        Finish(npc);
        return;
    }
    if (!npc.DenWanderReady || !partner.DenWanderReady) {
        if (Game.FrameTime >= npc.DenWanderRecheckAt) {
            npc.DenWanderRecheckAt = Game.FrameTime + Time::Seconds(5);
            if ((!CanStand(npc, map, npc.DenWanderGoal) || !CanStand(partner, map, partner.DenWanderGoal)) && !PairGoals(npc, partner, map)) {
                Stop(npc);
                Stop(partner);
                partner.DenWanderReady = false;
                npc.DenWanderReady = false;
                partner.DenWanderRecheckAt = npc.DenWanderRecheckAt;
            }
        }
        if (npc.Hex != npc.DenWanderGoal) {
            Walk(npc);
            return;
        }
        Stop(npc);
        npc.DenWanderReady = true;
        if (partner.Hex != partner.DenWanderGoal) {
            return;
        }
        partner.DenWanderReady = true;
        if (npc.DenWanderSayAt == ZERO_NANOTIME) {
            npc.DenWanderSayAt = Game.FrameTime + Time::Seconds(Game.Random(30, 60));
            partner.DenWanderSayAt = Game.FrameTime + Time::Seconds(Game.Random(30, 60));
        }
    }
    SayPeriodically(npc, "Brawl", 13);
    if (!npc.DenWanderFleeing && npc.CurrentHp * 100 < npc.MaxLife * 10) {
        npc.DenWanderFleeing = true;
        npc.DenWanderGoal = mpos();
        npc.DenWanderRecheckAt = ZERO_NANOTIME;
        Stop(npc);
    }
    if (npc.DenWanderFleeing) {
        if (Game.FrameTime >= npc.DenWanderRecheckAt || npc.Hex == npc.DenWanderGoal) {
            npc.DenWanderRecheckAt = Game.FrameTime + Time::Seconds(5);
            if (npc.Hex == npc.DenWanderGoal || !CanStand(npc, map, npc.DenWanderGoal) || Game.GetDistance(npc.DenWanderGoal, partner.Hex) < 6) {
                Stop(npc);
                PickGoal(npc, map, partner);
            }
        }
        Walk(npc, true);
    }
    else {
        Attack(npc, partner, true);
    }
}

Critter? FindRockTarget(Critter npc, Map map)
{
    auto ids = Game.DenDefenseParticipantIds.clone();
    ids.insertLast(Game.DenDefenseCompanionIds);
    ids.insertLast(Game.DenDefenseSmittyId);
    Critter? best = null;
    int nearest = 2147483647;
    for (int i = 0; i < ids.length(); i++) {
        Critter? target = Game.GetCritter(ids[i]);
        if (target == null || target.IsDead() || !DenDefense::CanAttack(npc, target) || !npc.IsSee(target)) {
            continue;
        }
        int distance = Game.GetDistance(npc, target);
        int cut = 1 + npc.Multihex + target.Multihex;
        if (distance < nearest && (distance <= cut || map.GetPathLength(npc, target.Hex, cut, MainPlanes::CanOpenDoor) > 0)) {
            best = target;
            nearest = distance;
        }
    }
    return best;
}

void ProcessRocks(Critter npc, Map map)
{
    Critter? target = FindRockTarget(npc, map);
    if (target != null) {
        Attack(npc, target);
        return;
    }
    Item? best = null;
    int nearest = 2147483647;
    auto rocks = map.GetItems(Content::Item::rock);
    for (int i = 0; i < rocks.length(); i++) {
        int distance = Game.GetDistance(npc.Hex, rocks[i].Hex);
        if (distance < nearest && (distance <= 1 + npc.Multihex || map.GetPathLength(npc, rocks[i].Hex, 1 + npc.Multihex, MainPlanes::CanOpenDoor) > 0)) {
            best = rocks[i];
            nearest = distance;
        }
    }
    if (best != null && npc.GetItem(Content::Item::rock) == null) {
        auto planes = NpcPlanes::GetPlanes(npc);
        if (planes == null || planes[0].Type != NpcPlanes::AI_PLANE_PICK || planes[0].Pick_Hex != best.Hex) {
            Stop(npc);
            NpcPlanes::AddPickPlane(npc, 0, best, ZERO_IDENT, false);
        }
        return;
    }
    // Без камней и без вплотную подошедшего врага рукопашного преследования нет.
    auto planes = NpcPlanes::GetPlanes(npc);
    if (planes != null && planes[0].Type == NpcPlanes::AI_PLANE_ATTACK) {
        Stop(npc);
    }
    ProcessWalk(npc, map, false);
}

// MainPlanes вызывает до общего подбора оружия: драка строго на кулаках,
// метатель безоружен только вплотную, в остальных случаях бросает настоящий камень.
bool ChooseWeapon(Critter npc, Critter? target, any& weaponId, any& use, any& unarmedPid)
{
    if (!npc.DenWanderActive || (npc.DenWanderMode != BRAWL && npc.DenWanderMode != ROCKS)) {
        return false;
    }
    weaponId = 0;
    use = 0;
    unarmedPid = Content::Item::default_weapon.hash;
    if (npc.DenWanderMode == ROCKS && target != null && Game.GetDistance(npc, target) > 1 + npc.Multihex + target.Multihex) {
        Item? rock = npc.GetItem(Content::Item::rock);
        if (rock != null) {
            weaponId = rock.Id;
        }
    }
    return true;
}

bool IsRunnerTarget(Critter npc, Map map, Critter? target)
{
    if (target == null || !target.IsAlive() || !DenDefense::CanSelectTarget(npc, target) || !npc.IsSee(target)) {
        return false;
    }
    int cut = 2 + npc.Multihex + target.Multihex;
    return Game.GetDistance(npc, target) <= cut || map.GetPathLength(npc, target.Hex, cut, MainPlanes::CanOpenDoor) > 0;
}

bool PickRunnerGoal(Critter npc, Map map, Critter target)
{
    int phase = npc.DenWanderRunPhase;
    int padding = npc.Multihex + target.Multihex;
    int minRadius = (phase == RUN_APPROACH ? 2 : (phase == RUN_RETREAT ? 8 : 5)) + padding;
    int maxRadius = (phase == RUN_APPROACH ? 2 : (phase == RUN_RETREAT ? 12 : 9)) + padding;
    // Следующая дуга в одном направлении, а не случайная точка через центр цели.
    float angle = phase == RUN_CIRCLE ? float(npc.DenWanderRunTurn * Game.Random(60, 100)) : 0.0f;
    mpos ideal = target.Hex;
    map.MoveHexByDir(ideal, Game.GetDirection(target.Hex, npc.Hex, angle), Game.Random(minRadius, maxRadius));
    auto occupied = NpcPositioning::StopPositions(npc, map);
    mpos[] candidates = {};
    for (int x = Math::Max(49, int(target.Hex.x) - maxRadius); x <= Math::Min(99, int(target.Hex.x) + maxRadius); x++) {
        for (int y = Math::Max(33, int(target.Hex.y) - maxRadius); y <= Math::Min(128, int(target.Hex.y) + maxRadius); y++) {
            mpos hex = mpos(x, y);
            int distance = Game.GetDistance(hex, target.Hex);
            if (hex != npc.Hex && distance >= minRadius && distance <= maxRadius && occupied.IsFree(hex) && map.IsHexesMovable(hex, npc.Multihex)) {
                candidates.insertLast(hex);
            }
        }
    }
    while (!candidates.isEmpty()) {
        int best = 0;
        for (int i = 1; i < candidates.length(); i++) {
            if (Game.GetDistance(candidates[i], ideal) < Game.GetDistance(candidates[best], ideal)) {
                best = i;
            }
        }
        mpos hex = candidates[best];
        candidates.removeAt(best);
        if (map.GetPathLength(npc, hex, 0, MainPlanes::CanOpenDoor) > 0) {
            npc.DenWanderGoal = hex;
            npc.DenWanderFocus = target.Hex;
            return true;
        }
    }
    npc.DenWanderGoal = mpos();
    return false;
}

Critter? FindRunnerTarget(Critter npc, Map map)
{
    auto ids = Game.DenDefenseParticipantIds.clone();
    ids.insertLast(Game.DenDefenseCompanionIds);
    ids.insertLast(Game.DenDefenseSmittyId);
    npc.DenWanderRunPhase = RUN_CIRCLE;
    npc.DenWanderRunTurn = Game.Random(0, 1) == 0 ? -1 : 1;
    while (!ids.isEmpty()) {
        int index = Game.Random(0, ids.length() - 1);
        Critter? target = Game.GetCritter(ids[index]);
        ids.removeAt(index);
        if (target != null && IsRunnerTarget(npc, map, target) && PickRunnerGoal(npc, map, target)) {
            npc.DenWanderTargetId = target.Id;
            npc.DenWanderUntil = Game.FrameTime + Time::Seconds(Game.Random(20, 40));
            return target;
        }
    }
    return null;
}

void ProcessRunner(Critter npc, Map map)
{
    if (npc.IsNoMove) {
        Stop(npc);
        return;
    }
    Critter? target = Game.GetCritter(npc.DenWanderTargetId);
    bool replan = false;
    if (!IsRunnerTarget(npc, map, target)) {
        Stop(npc);
        npc.DenWanderTargetId = ZERO_IDENT;
        npc.DenWanderGoal = mpos();
        if (Game.FrameTime < npc.DenWanderRecheckAt) {
            return;
        }
        npc.DenWanderRecheckAt = Game.FrameTime + Time::Seconds(5);
        target = FindRunnerTarget(npc, map);
        if (target == null) {
            return; // Не заменяем недоступную боевую цель нейтральным NPC или союзником.
        }
        replan = true;
    }
    if (target == null) {
        return;
    }
    int gap = Game.GetDistance(npc, target) - npc.Multihex - target.Multihex;
    if (npc.DenWanderRunPhase != RUN_RETREAT && gap <= 2) {
        npc.DenWanderRunPhase = RUN_RETREAT;
        npc.DenWanderUntil = Game.FrameTime + Time::Seconds(Game.Random(20, 40));
        replan = true;
    }
    else if (npc.DenWanderRunPhase == RUN_RETREAT && gap >= 8) {
        npc.DenWanderRunPhase = RUN_CIRCLE;
        replan = true;
    }
    else if (npc.DenWanderRunPhase == RUN_CIRCLE && Game.FrameTime >= npc.DenWanderUntil) {
        npc.DenWanderRunPhase = RUN_APPROACH;
        replan = true;
    }
    if (replan || npc.Hex == npc.DenWanderGoal || Game.GetDistance(target.Hex, npc.DenWanderFocus) >= 2 ||
        (Game.FrameTime >= npc.DenWanderRecheckAt && !CanStand(npc, map, npc.DenWanderGoal))) {
        Stop(npc);
        if (!PickRunnerGoal(npc, map, target)) {
            // Кольцо в два гекса может быть перекрыто или выходить за поле: не лезем
            // вплотную и не стоим в ожидании удара, а продолжаем кружить снаружи.
            npc.DenWanderRunPhase = RUN_CIRCLE;
            npc.DenWanderUntil = Game.FrameTime + Time::Seconds(Game.Random(20, 40));
            if (!PickRunnerGoal(npc, map, target)) {
                npc.DenWanderTargetId = ZERO_IDENT;
                npc.DenWanderRecheckAt = Game.FrameTime + Time::Seconds(5);
                return;
            }
        }
        npc.DenWanderRecheckAt = Game.FrameTime + Time::Seconds(2);
        Walk(npc, true);
        // План остаётся владельцем маршрута, но первый шаг не ждёт секундного
        // тика NpcPlanes: особенно важно сразу отскочить при достижении двух гексов.
        if (!CritterState::IsBusy(npc)) {
            int speed = CanRun(npc) && !npc.IsDamagedLeftLeg && !npc.IsDamagedRightLeg && !npc.IsOverweight ? npc.WalkSpeed * 2 : npc.WalkSpeed;
            npc.MoveToHex(npc.DenWanderGoal, 0, speed, MainPlanes::CanOpenDoor);
        }
    }
    else {
        Walk(npc, true);
    }
}

[[Event]]
void RunnerMoved(Critter npc, mpos oldHex)
{
    if (!npc.DenWanderActive || npc.DenWanderMode != RUN || npc.DenWanderRunPhase == RUN_RETREAT || !npc.IsAlive() || !DenDefense::CanAct(npc) ||
        Game.DenDefenseStage != DenDefense::STAGE_FIGHTING || !DenDefense::IsWaveEnemy(npc)) {
        return;
    }
    Critter? target = Game.GetCritter(npc.DenWanderTargetId);
    if (target != null && target.MapId == npc.MapId && Game.GetDistance(npc, target) <= 2 + npc.Multihex + target.Multihex) {
        Map? map = npc.GetMap();
        if (map != null) {
            ProcessRunner(npc, map);
        }
    }
}

void ProcessWalk(Critter npc, Map map, bool run)
{
    if (Game.FrameTime >= npc.DenWanderRecheckAt || npc.Hex == npc.DenWanderGoal) {
        npc.DenWanderRecheckAt = Game.FrameTime + Time::Seconds(5);
        if (npc.Hex == npc.DenWanderGoal || !CanStand(npc, map, npc.DenWanderGoal)) {
            Stop(npc);
            PickGoal(npc, map);
        }
    }
    Walk(npc, run);
}

// true подавляет обычный выбор жертвы; завершённое занятие возвращает штатный ИИ.
bool Process(Critter npc, Map map)
{
    if (!npc.DenWanderActive) {
        return false;
    }
    if (npc.DenWanderMode == STARE) {
        ProcessStare(npc, map);
    }
    else if (npc.DenWanderMode == BRAWL) {
        ProcessBrawl(npc, map);
    }
    else if (npc.DenWanderMode == ROCKS) {
        ProcessRocks(npc, map);
    }
    else if (npc.DenWanderMode == RUN) {
        ProcessRunner(npc, map);
    }
    else if (npc.DenWanderMode == LOST) {
        if (IsYardHex(npc.DenWanderGoal) && npc.Hex == npc.DenWanderGoal) {
            Arrive(npc);
        }
        else if (!Retaliate(npc, map)) {
            ProcessWalk(npc, map, false);
        }
    }
    return npc.DenWanderActive;
}

#endif

}
